{
  "type": "assettocorsa",
  "display": "Assetto Corsa (Docker)",
  "data": {
    "ADMIN_PASSWORD": {
      "type": "string",
      "value": "",
      "display": "Admin Password",
      "desc": "Used to log in as server administrator. Type /help in game for the available commands.",
      "required": true,
      "userEdit": true
    },
    "HOSTNAME": {
      "type": "string",
      "value": "PufferPanel Server",
      "display": "Server Name",
      "desc": "Name of the server as shown in the server browser",
      "required": true,
      "userEdit": true
    },
    "HTTP_PORT": {
      "type": "integer",
      "value": 8081,
      "display": "HTTP Port",
      "desc": "TCP port of the built-in HTTP server used by the lobby",
      "required": true,
      "userEdit": false
    },
    "PASSWORD": {
      "type": "string",
      "value": "",
      "display": "Server Password",
      "desc": "If set, players must enter this password to join the server",
      "required": false,
      "userEdit": true
    },
    "SRCDS_APPID": {
      "type": "string",
      "value": "302550",
      "display": "Steam App ID",
      "desc": "SteamCMD application id of the Assetto Corsa dedicated server",
      "required": true,
      "userEdit": false
    },
    "STEAM_PASS": {
      "type": "string",
      "value": "",
      "display": "Steam Password",
      "desc": "Password of the Steam account",
      "required": true,
      "userEdit": false
    },
    "STEAM_USER": {
      "type": "string",
      "value": "",
      "display": "Steam Username",
      "desc": "A Steam account that owns Assetto Corsa is required. Anonymous login cannot be used. Steam Guard must be turned off, because the code expires before a slow install finishes.",
      "required": true,
      "userEdit": false
    },
    "UPDATE_ON_BOOT": {
      "type": "boolean",
      "value": true,
      "display": "Update On Boot",
      "desc": "Run SteamCMD before every server start so the server is always up to date",
      "required": false,
      "userEdit": true
    },
    "port": {
      "type": "integer",
      "value": 9600,
      "display": "Port",
      "desc": "Port used for both the TCP and the UDP game traffic",
      "required": true,
      "userEdit": false
    }
  },
  "groups": [
    {
      "display": "Server",
      "description": "General server settings",
      "variables": [
        "HOSTNAME",
        "PASSWORD",
        "ADMIN_PASSWORD",
        "port",
        "HTTP_PORT"
      ],
      "order": 1
    },
    {
      "display": "SteamCMD",
      "description": "Steam credentials and update settings",
      "variables": [
        "SRCDS_APPID",
        "STEAM_USER",
        "STEAM_PASS",
        "UPDATE_ON_BOOT"
      ],
      "order": 2
    }
  ],
  "install": [
    {
      "type": "mkdir",
      "target": "steamcmd"
    },
    {
      "type": "mkdir",
      "target": "steamapps"
    },
    {
      "type": "download",
      "files": [
        "https://steamcdn-a.akamaihd.net/client/installer/steamcmd_linux.tar.gz"
      ]
    },
    {
      "type": "extract",
      "source": "steamcmd_linux.tar.gz",
      "destination": "steamcmd"
    },
    {
      "type": "command",
      "commands": [
        "./steamcmd/steamcmd.sh +force_install_dir /pufferpanel +login ${STEAM_USER} ${STEAM_PASS} +app_update ${SRCDS_APPID} validate +quit"
      ]
    },
    {
      "type": "mkdir",
      "target": ".steam/sdk32"
    },
    {
      "type": "mkdir",
      "target": ".steam/sdk64"
    },
    {
      "type": "command",
      "commands": [
        "cp steamcmd/linux32/steamclient.so .steam/sdk32/steamclient.so",
        "cp steamcmd/linux64/steamclient.so .steam/sdk64/steamclient.so",
        "rm -f steamcmd_linux.tar.gz",
        "chmod +x ./acServer"
      ]
    }
  ],
  "run": {
    "command": "./acServer",
    "stopCode": 2,
    "pre": [
      {
        "if": "UPDATE_ON_BOOT",
        "type": "command",
        "commands": [
          "./steamcmd/steamcmd.sh +force_install_dir /pufferpanel +login ${STEAM_USER} ${STEAM_PASS} +app_update ${SRCDS_APPID} +quit"
        ]
      },
      {
        "if": "file_exists('cfg/server_cfg.ini')",
        "type": "alterfile",
        "file": "cfg/server_cfg.ini",
        "search": "^NAME=.*$",
        "replace": "NAME=${HOSTNAME}",
        "regex": true
      },
      {
        "if": "file_exists('cfg/server_cfg.ini')",
        "type": "alterfile",
        "file": "cfg/server_cfg.ini",
        "search": "^PASSWORD=.*$",
        "replace": "PASSWORD=${PASSWORD}",
        "regex": true
      },
      {
        "if": "file_exists('cfg/server_cfg.ini')",
        "type": "alterfile",
        "file": "cfg/server_cfg.ini",
        "search": "^ADMIN_PASSWORD=.*$",
        "replace": "ADMIN_PASSWORD=${ADMIN_PASSWORD}",
        "regex": true
      },
      {
        "if": "file_exists('cfg/server_cfg.ini')",
        "type": "alterfile",
        "file": "cfg/server_cfg.ini",
        "search": "^UDP_PORT=.*$",
        "replace": "UDP_PORT=${port}",
        "regex": true
      },
      {
        "if": "file_exists('cfg/server_cfg.ini')",
        "type": "alterfile",
        "file": "cfg/server_cfg.ini",
        "search": "^TCP_PORT=.*$",
        "replace": "TCP_PORT=${port}",
        "regex": true
      },
      {
        "if": "file_exists('cfg/server_cfg.ini')",
        "type": "alterfile",
        "file": "cfg/server_cfg.ini",
        "search": "^HTTP_PORT=.*$",
        "replace": "HTTP_PORT=${HTTP_PORT}",
        "regex": true
      }
    ],
    "stdin": {
      "type": "stdin"
    },
    "autostart": false,
    "autorecover": false,
    "autorestart": false
  },
  "environment": {
    "type": "docker",
    "image": "ghcr.io/ptero-eggs/steamcmd:debian",
    "portBindings": [
      "0.0.0.0:${port}:${port}/tcp",
      "0.0.0.0:${port}:${port}/udp",
      "0.0.0.0:${HTTP_PORT}:${HTTP_PORT}/tcp"
    ]
  },
  "supportedEnvironments": [
    {
      "type": "docker",
      "image": "ghcr.io/ptero-eggs/steamcmd:debian",
      "portBindings": [
        "0.0.0.0:${port}:${port}/tcp",
        "0.0.0.0:${port}:${port}/udp",
        "0.0.0.0:${HTTP_PORT}:${HTTP_PORT}/tcp"
      ]
    }
  ],
  "requirements": {
    "os": "linux",
    "arch": "amd64"
  }
}

      "value": 7777,
      "display": "Port",
      "desc": "UDP port the game server binds to",
      "required": true,
      "userEdit": false
    }
  },
  "install": [
    {
      "type": "mkdir",
      "target": "steamcmd"
    },
    {
      "type": "mkdir",
      "target": "steamapps"
    },
    {
      "type": "download",
      "files": [
        "https://steamcdn-a.akamaihd.net/client/installer/steamcmd_linux.tar.gz"
      ]
    },
    {
      "type": "extract",
      "source": "steamcmd_linux.tar.gz",
      "destination": "steamcmd"
    },
    {
      "type": "command",
      "commands": [
        "./steamcmd/steamcmd.sh +force_install_dir /pufferpanel +login anonymous +app_update ${SRCDS_APPID} validate +quit"
      ]
    },
    {
      "type": "mkdir",
      "target": ".steam/sdk32"
    },
    {
      "type": "mkdir",
      "target": ".steam/sdk64"
    },
    {
      "type": "command",
      "commands": [
        "cp steamcmd/linux32/steamclient.so .steam/sdk32/steamclient.so",
        "cp steamcmd/linux64/steamclient.so .steam/sdk64/steamclient.so",
        "rm -f steamcmd_linux.tar.gz",
        "chmod +x SMALLAND/Binaries/Linux/SMALLANDServer-Linux-Shipping"
      ]
    }
  ],
  "run": {
    "command": "bash -c 'OPTS=\"\"; [ -n \"${PASSWORD}\" ] && OPTS=\"$OPTS?PASSWORD=${PASSWORD}\"; [ \"${FRIENDLYFIRE}\" = \"0\" ] || OPTS=\"$OPTS?FRIENDLYFIRE\"; [ \"${PEACEFULMODE}\" = \"0\" ] || OPTS=\"$OPTS?PEACEFULMODE\"; [ \"${KEEPINVENTORY}\" = \"0\" ] || OPTS=\"$OPTS?KEEPINVENTORY\"; [ \"${DETERIORATION}\" = \"1\" ] || OPTS=\"$OPTS?NODETERIORATION\"; [ \"${PRIVATE}\" = \"0\" ] || OPTS=\"$OPTS?PRIVATE\"; exec ./SMALLAND/Binaries/Linux/SMALLANDServer-Linux-Shipping SMALLAND \"/Game/Maps/WorldGame/WorldGame_Smalland?SERVERNAME=${SERVERNAME}?WORLDNAME=${WORLDNAME}$OPTS?lengthofdayseconds=${LENGTHOFDAYSECONDS}?lengthofseasonseconds=${LENGTHOFSEASONSECONDS}?creaturehealthmodifier=${CREATUREHEALTHMODIFIER}?creaturedamagemodifier=${CREATUREDAMAGEMODIFIER}?nourishmentlossmodifier=${NOURISHMENTLOSSMODIFIER}?falldamagemodifier=${FALLDAMAGEMODIFIER}\" -ini:Engine:[EpicOnlineServices]:DeploymentId=50f2b148496e4cbbbdeefbecc2ccd6a3 -ini:Engine:[EpicOnlineServices]:DedicatedServerClientId=xyza78918KT08TkA6emolUay8yhvAAy2 -ini:Engine:[EpicOnlineServices]:DedicatedServerClientSecret=aN2GtVw7aHb6hx66HwohNM+qktFaO3vtrLSbGdTzZWk -ini:Engine:[EpicOnlineServices]:DedicatedServerPrivateKey= -port=${port} -NOSTEAM -log'",
    "stopCode": 2,
    "pre": [
      {
        "if": "UPDATE_ON_BOOT",
        "type": "command",
        "commands": [
          "./steamcmd/steamcmd.sh +force_install_dir /pufferpanel +login anonymous +app_update ${SRCDS_APPID} +quit"
        ]
      }
    ],
    "stdin": {
      "type": "stdin"
    },
    "autostart": false,
    "autorecover": false,
    "autorestart": false
  },
  "environment": {
    "type": "docker",
    "image": "ghcr.io/ptero-eggs/steamcmd:debian",
    "portBindings": [
      "0.0.0.0:${port}:${port}/udp"
    ]
  },
  "supportedEnvironments": [
    {
      "type": "docker",
      "image": "ghcr.io/ptero-eggs/steamcmd:debian",
      "portBindings": [
        "0.0.0.0:${port}:${port}/udp"
      ]
    }
  ],
  "requirements": {
    "os": "linux",
    "arch": "amd64"
  }
}

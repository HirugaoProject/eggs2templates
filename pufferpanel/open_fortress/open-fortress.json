{
  "type": "srcds",
  "display": "Open Fortress (Docker)",
  "data": {
    "MAXPLAYERS": {
      "type": "integer",
      "value": 24,
      "display": "Max Players",
      "desc": "Maximum number of players on the server",
      "required": true,
      "userEdit": true
    },
    "SRCDS_APPID": {
      "type": "string",
      "value": "244310",
      "display": "Steam App ID",
      "desc": "SteamCMD application id of the Source SDK Base 2013 dedicated server dedicated server",
      "required": true,
      "userEdit": false
    },
    "SRCDS_GAME": {
      "type": "string",
      "value": "open_fortress",
      "display": "Game Name",
      "desc": "Source engine game directory to load",
      "required": true,
      "userEdit": false
    },
    "SRCDS_MAP": {
      "type": "string",
      "value": "dm_2fort",
      "display": "Default Map",
      "desc": "Map the server loads on boot",
      "required": true,
      "userEdit": true
    },
    "UPDATE_ON_BOOT": {
      "type": "boolean",
      "value": true,
      "display": "Update On Boot",
      "desc": "Run SteamCMD before every server start so the server is always up to date",
      "required": false,
      "userEdit": true
    },
    "port": {
      "type": "integer",
      "value": 27015,
      "display": "Port",
      "desc": "Port the server binds to",
      "required": true,
      "userEdit": false
    }
  },
  "install": [
    {
      "type": "mkdir",
      "target": "steamcmd"
    },
    {
      "type": "mkdir",
      "target": "steamapps"
    },
    {
      "type": "download",
      "files": [
        "https://steamcdn-a.akamaihd.net/client/installer/steamcmd_linux.tar.gz"
      ]
    },
    {
      "type": "extract",
      "source": "steamcmd_linux.tar.gz",
      "destination": "steamcmd"
    },
    {
      "type": "command",
      "commands": [
        "./steamcmd/steamcmd.sh +force_install_dir /pufferpanel +login anonymous +app_update ${SRCDS_APPID} validate +quit"
      ]
    },
    {
      "type": "mkdir",
      "target": ".steam/sdk32"
    },
    {
      "type": "mkdir",
      "target": ".steam/sdk64"
    },
    {
      "type": "command",
      "commands": [
        "cp steamcmd/linux32/steamclient.so .steam/sdk32/steamclient.so",
        "cp steamcmd/linux64/steamclient.so .steam/sdk64/steamclient.so",
        "rm -f steamcmd_linux.tar.gz",
        "chmod +x ./srcds_run"
      ]
    },
    {
      "type": "command",
      "commands": [
        "bash -c 'curl -sSL -o beans https://beans.adastral.net/beans'",
        "chmod +x ./beans",
        "./beans --install /pufferpanel"
      ]
    }
  ],
  "run": {
    "command": "./srcds_run -game ${SRCDS_GAME} -console -port ${port} +map ${SRCDS_MAP} +ip 0.0.0.0 -strictportbind -norestart +maxplayers ${MAXPLAYERS}",
    "stop": "quit",
    "pre": [
      {
        "if": "UPDATE_ON_BOOT",
        "type": "command",
        "commands": [
          "./steamcmd/steamcmd.sh +force_install_dir /pufferpanel +login anonymous +app_update ${SRCDS_APPID} +quit"
        ]
      }
    ],
    "stdin": {
      "type": "stdin"
    },
    "autostart": false,
    "autorecover": false,
    "autorestart": false
  },
  "environment": {
    "type": "docker",
    "image": "ghcr.io/ptero-eggs/games:source",
    "portBindings": [
      "0.0.0.0:${port}:${port}/tcp",
      "0.0.0.0:${port}:${port}/udp"
    ]
  },
  "supportedEnvironments": [
    {
      "type": "docker",
      "image": "ghcr.io/ptero-eggs/games:source",
      "portBindings": [
        "0.0.0.0:${port}:${port}/tcp",
        "0.0.0.0:${port}:${port}/udp"
      ]
    }
  ],
  "requirements": {
    "os": "linux",
    "arch": "amd64"
  }
}

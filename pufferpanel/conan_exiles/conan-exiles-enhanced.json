{
  "type": "conanexiles",
  "display": "Conan Exiles Enhanced (Docker)",
  "data": {
    "ADMIN_PASSWORD": {
      "type": "string",
      "value": "",
      "display": "Admin Password",
      "desc": "Password used to change server settings from inside the game",
      "required": false,
      "userEdit": true
    },
    "MAX_PLAYERS": {
      "type": "integer",
      "value": 10,
      "display": "Max Players",
      "desc": "Maximum number of players allowed to connect at the same time",
      "required": true,
      "userEdit": true
    },
    "RCON_ENABLED": {
      "type": "option",
      "value": "0",
      "display": "Enable RCON",
      "desc": "Enable the RCON plugin",
      "required": true,
      "userEdit": true,
      "options": [
        {
          "value": "0",
          "display": "Disabled"
        },
        {
          "value": "1",
          "display": "Enabled"
        }
      ]
    },
    "RCON_PASSWORD": {
      "type": "string",
      "value": "",
      "display": "RCON Password",
      "desc": "RCON password. RCON is disabled when this is empty.",
      "required": false,
      "userEdit": true
    },
    "RCON_PORT": {
      "type": "integer",
      "value": 25575,
      "display": "RCON Port",
      "desc": "Port used for remote administrative access",
      "required": true,
      "userEdit": false
    },
    "QUERY_PORT": {
      "type": "integer",
      "value": 27015,
      "display": "Query Port",
      "desc": "Steam query port used by the server",
      "required": true,
      "userEdit": false
    },
    "SERVER_NAME": {
      "type": "string",
      "value": "PufferPanel hosted Server",
      "display": "Server Name",
      "desc": "Name used by the server in the server browser",
      "required": true,
      "userEdit": true
    },
    "SERVER_PASSWORD": {
      "type": "string",
      "value": "",
      "display": "Server Password",
      "desc": "Password players must enter to join. Leave blank for a public server.",
      "required": false,
      "userEdit": true
    },
    "SRCDS_APPID": {
      "type": "string",
      "value": "443030",
      "display": "Steam App ID",
      "desc": "SteamCMD application id of the Conan Exiles dedicated server",
      "required": true,
      "userEdit": false
    },
    "UPDATE_ON_BOOT": {
      "type": "boolean",
      "value": true,
      "display": "Update On Boot",
      "desc": "Run SteamCMD before every server start so the server is always up to date",
      "required": false,
      "userEdit": true
    },
    "port": {
      "type": "integer",
      "value": 7777,
      "display": "Game Port",
      "desc": "UDP port the game server binds to",
      "required": true,
      "userEdit": false
    }
  },
  "install": [
    {
      "type": "mkdir",
      "target": "steamcmd"
    },
    {
      "type": "mkdir",
      "target": "steamapps"
    },
    {
      "type": "download",
      "files": [
        "https://steamcdn-a.akamaihd.net/client/installer/steamcmd_linux.tar.gz"
      ]
    },
    {
      "type": "extract",
      "source": "steamcmd_linux.tar.gz",
      "destination": "steamcmd"
    },
    {
      "type": "command",
      "commands": [
        "./steamcmd/steamcmd.sh +force_install_dir /pufferpanel +login anonymous +app_update ${SRCDS_APPID} validate +quit"
      ]
    },
    {
      "type": "mkdir",
      "target": ".steam/sdk32"
    },
    {
      "type": "mkdir",
      "target": ".steam/sdk64"
    },
    {
      "type": "mkdir",
      "target": "ConanSandbox/Saved/Config/LinuxServer"
    },
    {
      "type": "mkdir",
      "target": "ConanSandbox/Mods"
    },
    {
      "type": "command",
      "commands": [
        "cp steamcmd/linux32/steamclient.so .steam/sdk32/steamclient.so",
        "cp steamcmd/linux64/steamclient.so .steam/sdk64/steamclient.so",
        "rm -f steamcmd_linux.tar.gz",
        "chmod +x ./ConanSandbox/Binaries/Linux/ConanSandboxServer-Linux-Shipping"
      ]
    },
    {
      "if": "!file_exists('ConanSandbox/Mods/modlist.txt')",
      "type": "writefile",
      "target": "ConanSandbox/Mods/modlist.txt",
      "text": ""
    },
    {
      "if": "!file_exists('ConanSandbox/Saved/Config/LinuxServer/Game.ini')",
      "type": "writefile",
      "target": "ConanSandbox/Saved/Config/LinuxServer/Game.ini",
      "text": "[RconPlugin]\nRconEnabled=${RCON_ENABLED}\nRconPassword=${RCON_PASSWORD}\nRconPort=${RCON_PORT}\n"
    },
    {
      "if": "!file_exists('ConanSandbox/Saved/Config/LinuxServer/ServerSettings.ini')",
      "type": "writefile",
      "target": "ConanSandbox/Saved/Config/LinuxServer/ServerSettings.ini",
      "text": "[ServerSettings]\nAdminPassword=${ADMIN_PASSWORD}\n"
    }
  ],
  "run": {
    "command": [
      {
        "command": "./ConanSandbox/Binaries/Linux/ConanSandboxServer-Linux-Shipping -Port=${port} -QueryPort=${QUERY_PORT} -MaxPlayers=${MAX_PLAYERS} -ServerName=${SERVER_NAME} -ServerPassword=${SERVER_PASSWORD} -Multihome=0.0.0.0 -console -log",
        "if": "SERVER_PASSWORD != ''"
      },
      {
        "command": "./ConanSandbox/Binaries/Linux/ConanSandboxServer-Linux-Shipping -Port=${port} -QueryPort=${QUERY_PORT} -MaxPlayers=${MAX_PLAYERS} -ServerName=${SERVER_NAME} -Multihome=0.0.0.0 -console -log"
      }
    ],
    "stopCode": 2,
    "pre": [
      {
        "if": "UPDATE_ON_BOOT",
        "type": "command",
        "commands": [
          "./steamcmd/steamcmd.sh +force_install_dir /pufferpanel +login anonymous +app_update ${SRCDS_APPID} +quit"
        ]
      },
      {
        "if": "file_exists('ConanSandbox/Saved/Config/LinuxServer/ServerSettings.ini')",
        "type": "alterfile",
        "file": "ConanSandbox/Saved/Config/LinuxServer/ServerSettings.ini",
        "search": "^AdminPassword=.*$",
        "replace": "AdminPassword=${ADMIN_PASSWORD}",
        "regex": true
      },
      {
        "if": "file_exists('ConanSandbox/Saved/Config/LinuxServer/Game.ini')",
        "type": "alterfile",
        "file": "ConanSandbox/Saved/Config/LinuxServer/Game.ini",
        "search": "^RconEnabled=.*$",
        "replace": "RconEnabled=${RCON_ENABLED}",
        "regex": true
      },
      {
        "if": "file_exists('ConanSandbox/Saved/Config/LinuxServer/Game.ini')",
        "type": "alterfile",
        "file": "ConanSandbox/Saved/Config/LinuxServer/Game.ini",
        "search": "^RconPassword=.*$",
        "replace": "RconPassword=${RCON_PASSWORD}",
        "regex": true
      },
      {
        "if": "file_exists('ConanSandbox/Saved/Config/LinuxServer/Game.ini')",
        "type": "alterfile",
        "file": "ConanSandbox/Saved/Config/LinuxServer/Game.ini",
        "search": "^RconPort=.*$",
        "replace": "RconPort=${RCON_PORT}",
        "regex": true
      }
    ],
    "stdin": {
      "type": "stdin"
    },
    "autostart": false,
    "autorecover": false,
    "autorestart": false
  },
  "environment": {
    "type": "docker",
    "image": "ghcr.io/ptero-eggs/steamcmd:debian",
    "portBindings": [
      "0.0.0.0:${port}:${port}/udp",
      "0.0.0.0:${QUERY_PORT}:${QUERY_PORT}/udp",
      "0.0.0.0:${RCON_PORT}:${RCON_PORT}/tcp"
    ]
  },
  "supportedEnvironments": [
    {
      "type": "docker",
      "image": "ghcr.io/ptero-eggs/steamcmd:debian",
      "portBindings": [
        "0.0.0.0:${port}:${port}/udp",
        "0.0.0.0:${QUERY_PORT}:${QUERY_PORT}/udp",
        "0.0.0.0:${RCON_PORT}:${RCON_PORT}/tcp"
      ]
    }
  ],
  "requirements": {
    "os": "linux",
    "arch": "amd64"
  }
}

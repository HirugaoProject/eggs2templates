{
  "type": "minecraft-java",
  "display": "NanoLimbo (Docker)",
  "data": {
    "DOWNLOAD_URL": {
      "type": "string",
      "value": "https://github.com/Nan1t/NanoLimbo/releases/latest/download/NanoLimbo-1.9-all.jar",
      "display": "Download URL",
      "desc": "Link to the NanoLimbo jar. Releases are listed at https://github.com/Nan1t/NanoLimbo/releases",
      "required": true,
      "userEdit": true
    },
    "JAVA_VERSION": {
      "type": "option",
      "value": "21",
      "display": "Java Version",
      "desc": "Java runtime the server is started with",
      "required": true,
      "userEdit": true,
      "options": [
        {
          "value": "8",
          "display": "Java 8"
        },
        {
          "value": "11",
          "display": "Java 11"
        },
        {
          "value": "16",
          "display": "Java 16"
        },
        {
          "value": "17",
          "display": "Java 17"
        },
        {
          "value": "21",
          "display": "Java 21"
        },
        {
          "value": "22",
          "display": "Java 22"
        },
        {
          "value": "23",
          "display": "Java 23"
        },
        {
          "value": "24",
          "display": "Java 24"
        },
        {
          "value": "25",
          "display": "Java 25"
        }
      ]
    },
    "SERVER_JARFILE": {
      "type": "string",
      "value": "server.jar",
      "display": "Server Jar File",
      "desc": "Name of the jar the server is started from",
      "required": true,
      "userEdit": true
    },
    "SERVER_MEMORY": {
      "type": "integer",
      "value": 2048,
      "display": "Memory (MB)",
      "desc": "Java heap size for the server",
      "required": true,
      "userEdit": true
    },
    "port": {
      "type": "integer",
      "value": 25565,
      "display": "Port",
      "desc": "Port the server listens on, written to server.properties",
      "required": true,
      "userEdit": false
    }
  },
  "install": [
    {
      "type": "command",
      "commands": [
        "bash -c 'curl -sSL -o ${SERVER_JARFILE} \"${DOWNLOAD_URL}\"'"
      ]
    },
    {
      "if": "!file_exists('settings.yml')",
      "type": "download",
      "files": [
        "https://raw.githubusercontent.com/ptero-eggs/game-eggs/main/minecraft/java/nanolimbo/settings.yml"
      ]
    }
  ],
  "run": {
    "command": "java -Xms128M -Xmx${SERVER_MEMORY}M -jar ${SERVER_JARFILE}",
    "pre": [
      {
        "if": "file_exists('settings.yml')",
        "type": "alterfile",
        "file": "settings.yml",
        "search": "^(\\s*)port:.*$",
        "replace": "  port: ${port}",
        "regex": true
      }
    ],
    "stdin": {
      "type": "stdin"
    },
    "autostart": false,
    "autorecover": false,
    "autorestart": false,
    "stopCode": 2
  },
  "environment": {
    "type": "docker",
    "image": "ghcr.io/ptero-eggs/yolks:java_${JAVA_VERSION}",
    "portBindings": [
      "0.0.0.0:${port}:${port}/tcp",
      "0.0.0.0:${port}:${port}/udp"
    ]
  },
  "supportedEnvironments": [
    {
      "type": "docker",
      "image": "ghcr.io/ptero-eggs/yolks:java_${JAVA_VERSION}",
      "portBindings": [
        "0.0.0.0:${port}:${port}/tcp",
        "0.0.0.0:${port}:${port}/udp"
      ]
    }
  ],
  "requirements": {
    "os": "linux"
  }
}

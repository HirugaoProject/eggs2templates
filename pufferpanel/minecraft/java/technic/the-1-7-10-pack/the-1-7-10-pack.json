{
  "type": "minecraft-java",
  "display": "The 1.7.10 Pack (Docker)",
  "data": {
    "MODPACK_VERSION": {
      "type": "string",
      "value": "0.10.15",
      "display": "Modpack Version",
      "desc": "Version of the modpack server package downloaded from servers.technicpack.net",
      "required": true,
      "userEdit": true
    },
    "SERVER_MEMORY": {
      "type": "integer",
      "value": 4096,
      "display": "Memory (MB)",
      "desc": "Java heap size for the server",
      "required": true,
      "userEdit": true
    },
    "port": {
      "type": "integer",
      "value": 25565,
      "display": "Port",
      "desc": "Port the server listens on, written to server.properties",
      "required": true,
      "userEdit": false
    }
  },
  "install": [
    {
      "type": "download",
      "files": [
        "https://servers.technicpack.net/Technic/servers/the-1710-pack/the-1710-pack_${MODPACK_VERSION}.zip"
      ]
    },
    {
      "type": "extract",
      "source": "the-1710-pack_${MODPACK_VERSION}.zip",
      "destination": "."
    },
    {
      "type": "command",
      "commands": [
        "rm -f the-1710-pack_${MODPACK_VERSION}.zip",
        "rm -f RestoreBackup.bat LaunchServer.bat LaunchServer.sh RestoreBackup.sh launch.bat launch.sh"
      ]
    }
  ],
  "run": {
    "command": "bash -c 'exec java -Xms128M -Xmx${SERVER_MEMORY}M -jar forge-*.jar nogui'",
    "stop": "stop",
    "pre": [
      {
        "if": "file_exists('server.properties')",
        "type": "alterfile",
        "file": "server.properties",
        "search": "^server-port=.*$",
        "replace": "server-port=${port}",
        "regex": true
      },
      {
        "if": "file_exists('server.properties')",
        "type": "alterfile",
        "file": "server.properties",
        "search": "^server-ip=.*$",
        "replace": "server-ip=0.0.0.0",
        "regex": true
      },
      {
        "if": "file_exists('eula.txt')",
        "type": "alterfile",
        "file": "eula.txt",
        "search": "^eula=.*$",
        "replace": "eula=true",
        "regex": true
      },
      {
        "if": "!file_exists('eula.txt')",
        "type": "writefile",
        "target": "eula.txt",
        "text": "eula=true\n"
      }
    ],
    "stdin": {
      "type": "stdin"
    },
    "autostart": false,
    "autorecover": false,
    "autorestart": false
  },
  "environment": {
    "type": "docker",
    "image": "ghcr.io/ptero-eggs/yolks:java_8",
    "portBindings": [
      "0.0.0.0:${port}:${port}/tcp",
      "0.0.0.0:${port}:${port}/udp"
    ]
  },
  "supportedEnvironments": [
    {
      "type": "docker",
      "image": "ghcr.io/ptero-eggs/yolks:java_8",
      "portBindings": [
        "0.0.0.0:${port}:${port}/tcp",
        "0.0.0.0:${port}:${port}/udp"
      ]
    }
  ],
  "requirements": {
    "os": "linux"
  }
}

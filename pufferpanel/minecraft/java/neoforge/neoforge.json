{
  "type": "minecraft-java",
  "display": "NeoForge (Docker)",
  "data": {
    "JAVA_VERSION": {
      "type": "option",
      "value": "21",
      "display": "Java Version",
      "desc": "Java runtime the server is started with",
      "required": true,
      "userEdit": true,
      "options": [
        {
          "value": "8",
          "display": "Java 8"
        },
        {
          "value": "11",
          "display": "Java 11"
        },
        {
          "value": "16",
          "display": "Java 16"
        },
        {
          "value": "17",
          "display": "Java 17"
        },
        {
          "value": "21",
          "display": "Java 21"
        },
        {
          "value": "22",
          "display": "Java 22"
        },
        {
          "value": "23",
          "display": "Java 23"
        },
        {
          "value": "24",
          "display": "Java 24"
        },
        {
          "value": "25",
          "display": "Java 25"
        }
      ]
    },
    "MC_VERSION": {
      "type": "string",
      "value": "latest",
      "display": "Minecraft Version",
      "desc": "Minecraft version to install NeoForge for, or latest",
      "required": true,
      "userEdit": true
    },
    "NEOFORGE_VERSION": {
      "type": "string",
      "value": "",
      "display": "NeoForge Version",
      "desc": "NeoForge build to install. Leave blank for the newest build.",
      "required": false,
      "userEdit": true
    },
    "SERVER_MEMORY": {
      "type": "integer",
      "value": 2048,
      "display": "Memory (MB)",
      "desc": "Java heap size for the server",
      "required": true,
      "userEdit": true
    },
    "port": {
      "type": "integer",
      "value": 25565,
      "display": "Port",
      "desc": "Port the server listens on, written to server.properties",
      "required": true,
      "userEdit": false
    },
    "resolvedNeoForgeVersion": {
      "type": "string",
      "value": "",
      "display": "Resolved NeoForge Version",
      "desc": "Internal, filled in by the NeoForge downloader",
      "required": false,
      "userEdit": false,
      "internal": true
    }
  },
  "install": [
    {
      "type": "neoforgedl",
      "target": "installer.jar",
      "version": "${NEOFORGE_VERSION}",
      "minecraftVersion": "${MC_VERSION}",
      "outputVariable": "resolvedNeoForgeVersion"
    },
    {
      "type": "command",
      "commands": [
        "java -jar installer.jar --installServer",
        "rm -f installer.jar"
      ]
    },
    {
      "if": "!file_exists('server.properties')",
      "type": "download",
      "files": [
        "https://raw.githubusercontent.com/ptero-eggs/game-eggs/main/minecraft/java/server.properties"
      ]
    }
  ],
  "run": {
    "command": "java -Xms128M -Xmx${SERVER_MEMORY}M -Dterminal.jline=false -Dterminal.ansi=true @unix_args.txt nogui",
    "stop": "stop",
    "pre": [
      {
        "type": "resolveneoforgeversion",
        "minecraftVersion": "${MC_VERSION}",
        "version": "${NEOFORGE_VERSION}",
        "outputVariable": "resolvedNeoForgeVersion"
      },
      {
        "if": "file_exists('server.properties')",
        "type": "alterfile",
        "file": "server.properties",
        "search": "^server-port=.*$",
        "replace": "server-port=${port}",
        "regex": true
      },
      {
        "if": "file_exists('server.properties')",
        "type": "alterfile",
        "file": "server.properties",
        "search": "^server-ip=.*$",
        "replace": "server-ip=0.0.0.0",
        "regex": true
      },
      {
        "if": "file_exists('eula.txt')",
        "type": "alterfile",
        "file": "eula.txt",
        "search": "^eula=.*$",
        "replace": "eula=true",
        "regex": true
      },
      {
        "if": "!file_exists('eula.txt')",
        "type": "writefile",
        "target": "eula.txt",
        "text": "eula=true\n"
      }
    ],
    "stdin": {
      "type": "stdin"
    },
    "autostart": false,
    "autorecover": false,
    "autorestart": false
  },
  "environment": {
    "type": "docker",
    "image": "ghcr.io/ptero-eggs/yolks:java_${JAVA_VERSION}",
    "portBindings": [
      "0.0.0.0:${port}:${port}/tcp",
      "0.0.0.0:${port}:${port}/udp"
    ]
  },
  "supportedEnvironments": [
    {
      "type": "docker",
      "image": "ghcr.io/ptero-eggs/yolks:java_${JAVA_VERSION}",
      "portBindings": [
        "0.0.0.0:${port}:${port}/tcp",
        "0.0.0.0:${port}:${port}/udp"
      ]
    }
  ],
  "requirements": {
    "os": "linux"
  }
}

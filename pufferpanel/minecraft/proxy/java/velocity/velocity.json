{
  "type": "minecraft-java",
  "display": "Velocity (Docker)",
  "data": {
    "BUILD_NUMBER": {
      "type": "string",
      "value": "latest",
      "display": "Build Number",
      "desc": "Build to install, or latest",
      "required": true,
      "userEdit": true
    },
    "JAVA_VERSION": {
      "type": "option",
      "value": "21",
      "display": "Java Version",
      "desc": "Java runtime the proxy is started with",
      "required": true,
      "userEdit": true,
      "options": [
        {
          "value": "11",
          "display": "Java 11"
        },
        {
          "value": "17",
          "display": "Java 17"
        },
        {
          "value": "21",
          "display": "Java 21"
        },
        {
          "value": "22",
          "display": "Java 22"
        },
        {
          "value": "25",
          "display": "Java 25"
        }
      ]
    },
    "MINECRAFT_VERSION": {
      "type": "string",
      "value": "latest",
      "display": "Minecraft Version",
      "desc": "Version line to install, or latest",
      "required": true,
      "userEdit": true
    },
    "SERVER_JARFILE": {
      "type": "string",
      "value": "velocity.jar",
      "display": "Server Jar File",
      "desc": "Name of the jar the proxy is started from",
      "required": true,
      "userEdit": true
    },
    "SERVER_MEMORY": {
      "type": "integer",
      "value": 1024,
      "display": "Memory (MB)",
      "desc": "Java heap size for the proxy",
      "required": true,
      "userEdit": true
    },
    "port": {
      "type": "integer",
      "value": 25577,
      "display": "Port",
      "desc": "Port the proxy listens on",
      "required": true,
      "userEdit": false
    }
  },
  "install": [
    {
      "type": "paperdl",
      "project": "velocity",
      "minecraftVersion": "${MINECRAFT_VERSION}",
      "build": "${BUILD_NUMBER}",
      "target": "${SERVER_JARFILE}"
    }
  ],
  "run": {
    "command": "java -Xms128M -Xmx${SERVER_MEMORY}M -jar ${SERVER_JARFILE}",
    "stop": "end",
    "stdin": {
      "type": "stdin"
    },
    "autostart": false,
    "autorecover": false,
    "autorestart": false
  },
  "environment": {
    "type": "docker",
    "image": "ghcr.io/ptero-eggs/yolks:java_${JAVA_VERSION}",
    "portBindings": [
      "0.0.0.0:${port}:${port}/tcp",
      "0.0.0.0:${port}:${port}/udp"
    ]
  },
  "supportedEnvironments": [
    {
      "type": "docker",
      "image": "ghcr.io/ptero-eggs/yolks:java_${JAVA_VERSION}",
      "portBindings": [
        "0.0.0.0:${port}:${port}/tcp",
        "0.0.0.0:${port}:${port}/udp"
      ]
    }
  ],
  "requirements": {
    "os": "linux"
  }
}

{
  "type": "minecraft-bedrock",
  "display": "Vanilla Bedrock (Docker)",
  "data": {
    "BEDROCK_VERSION": {
      "type": "string",
      "value": "1.21.130.4",
      "display": "Bedrock Version",
      "desc": "Version of the Bedrock dedicated server to install. Current versions are listed at https://www.minecraft.net/download/server/bedrock",
      "required": true,
      "userEdit": true
    },
    "CHEATS": {
      "type": "option",
      "value": "false",
      "display": "Allow Cheats",
      "desc": "Allow cheat commands on the server",
      "required": true,
      "userEdit": true,
      "options": [
        {
          "value": "false",
          "display": "Disabled"
        },
        {
          "value": "true",
          "display": "Enabled"
        }
      ]
    },
    "DIFFICULTY": {
      "type": "option",
      "value": "easy",
      "display": "Difficulty",
      "desc": "World difficulty",
      "required": true,
      "userEdit": true,
      "options": [
        {
          "value": "peaceful",
          "display": "Peaceful"
        },
        {
          "value": "easy",
          "display": "Easy"
        },
        {
          "value": "normal",
          "display": "Normal"
        },
        {
          "value": "hard",
          "display": "Hard"
        }
      ]
    },
    "GAMEMODE": {
      "type": "option",
      "value": "survival",
      "display": "Gamemode",
      "desc": "Default gamemode for joining players",
      "required": true,
      "userEdit": true,
      "options": [
        {
          "value": "survival",
          "display": "Survival"
        },
        {
          "value": "creative",
          "display": "Creative"
        },
        {
          "value": "adventure",
          "display": "Adventure"
        }
      ]
    },
    "SERVERNAME": {
      "type": "string",
      "value": "Bedrock Dedicated Server",
      "display": "Server Name",
      "desc": "Name shown in the friends list",
      "required": true,
      "userEdit": true
    },
    "port": {
      "type": "integer",
      "value": 19132,
      "display": "Port",
      "desc": "UDP port the server listens on, written to server.properties",
      "required": true,
      "userEdit": false
    }
  },
  "install": [
    {
      "type": "download",
      "files": [
        "https://www.minecraft.net/bedrockdedicatedserver/bin-linux/bedrock-server-${BEDROCK_VERSION}.zip"
      ]
    },
    {
      "type": "extract",
      "source": "bedrock-server-${BEDROCK_VERSION}.zip",
      "destination": "."
    },
    {
      "type": "command",
      "commands": [
        "rm -f bedrock-server-${BEDROCK_VERSION}.zip",
        "chmod +x ./bedrock_server"
      ]
    }
  ],
  "run": {
    "command": "./bedrock_server",
    "stop": "stop",
    "environmentVars": {
      "LD_LIBRARY_PATH": "."
    },
    "pre": [
      {
        "if": "file_exists('server.properties')",
        "type": "alterfile",
        "file": "server.properties",
        "search": "^server-port=.*$",
        "replace": "server-port=${port}",
        "regex": true
      },
      {
        "if": "file_exists('server.properties')",
        "type": "alterfile",
        "file": "server.properties",
        "search": "^server-name=.*$",
        "replace": "server-name=${SERVERNAME}",
        "regex": true
      },
      {
        "if": "file_exists('server.properties')",
        "type": "alterfile",
        "file": "server.properties",
        "search": "^gamemode=.*$",
        "replace": "gamemode=${GAMEMODE}",
        "regex": true
      },
      {
        "if": "file_exists('server.properties')",
        "type": "alterfile",
        "file": "server.properties",
        "search": "^difficulty=.*$",
        "replace": "difficulty=${DIFFICULTY}",
        "regex": true
      },
      {
        "if": "file_exists('server.properties')",
        "type": "alterfile",
        "file": "server.properties",
        "search": "^allow-cheats=.*$",
        "replace": "allow-cheats=${CHEATS}",
        "regex": true
      }
    ],
    "stdin": {
      "type": "stdin"
    },
    "autostart": false,
    "autorecover": false,
    "autorestart": false
  },
  "environment": {
    "type": "docker",
    "image": "ghcr.io/ptero-eggs/yolks:debian",
    "portBindings": [
      "0.0.0.0:${port}:${port}/udp"
    ]
  },
  "supportedEnvironments": [
    {
      "type": "docker",
      "image": "ghcr.io/ptero-eggs/yolks:debian",
      "portBindings": [
        "0.0.0.0:${port}:${port}/udp"
      ]
    }
  ],
  "requirements": {
    "os": "linux",
    "arch": "amd64"
  }
}

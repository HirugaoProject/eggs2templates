{
  "type": "gtac",
  "display": "Grand Theft Auto Connected (Docker)",
  "data": {
    "DL_VERSION": {
      "type": "string",
      "value": "latest",
      "display": "Server Version",
      "desc": "Version of GTA Connected to install, such as 1.2.10, or latest for the newest build",
      "required": true,
      "userEdit": true
    },
    "GAMETYPE": {
      "type": "option",
      "value": "gta:iv",
      "display": "Game Type",
      "desc": "Game this server supports",
      "required": true,
      "userEdit": true,
      "options": [
        {
          "value": "gta:iii",
          "display": "GTA III"
        },
        {
          "value": "gta:vc",
          "display": "GTA Vice City"
        },
        {
          "value": "gta:sa",
          "display": "GTA San Andreas"
        },
        {
          "value": "gta:iv",
          "display": "GTA IV"
        }
      ]
    },
    "SERVERBROWSER": {
      "type": "option",
      "value": "true",
      "display": "Server Browser",
      "desc": "Show the server in the public server browser",
      "required": true,
      "userEdit": true,
      "options": [
        {
          "value": "true",
          "display": "Listed"
        },
        {
          "value": "false",
          "display": "Unlisted"
        }
      ]
    },
    "SERVERNAME": {
      "type": "string",
      "value": "PufferPanel Server",
      "display": "Server Name",
      "desc": "Name of the server in the server browser",
      "required": true,
      "userEdit": true
    },
    "port": {
      "type": "integer",
      "value": 22000,
      "display": "Port",
      "desc": "Port used for the game and for the HTTP resource server",
      "required": true,
      "userEdit": false
    }
  },
  "install": [
    {
      "if": "DL_VERSION == 'latest'",
      "type": "command",
      "commands": [
        "bash -c 'curl -sSL -o GTAC.tar.gz https://gtaconnected.com/downloads/server/latest/linux'"
      ]
    },
    {
      "if": "DL_VERSION != 'latest'",
      "type": "download",
      "files": [
        "https://gtaconnected.com/downloads/GTAC-Server-Linux-${DL_VERSION}.tar.gz"
      ]
    },
    {
      "if": "DL_VERSION != 'latest'",
      "type": "move",
      "source": "GTAC-Server-Linux-${DL_VERSION}.tar.gz",
      "target": "GTAC.tar.gz"
    },
    {
      "type": "extract",
      "source": "GTAC.tar.gz",
      "destination": "."
    },
    {
      "type": "command",
      "commands": [
        "rm -f GTAC.tar.gz",
        "chmod +x ./Server"
      ]
    }
  ],
  "run": {
    "command": "./Server",
    "stop": "quit",
    "pre": [
      {
        "if": "file_exists('server.xml')",
        "type": "alterfile",
        "file": "server.xml",
        "search": "<servername>[^<]*</servername>",
        "replace": "<servername>${SERVERNAME}</servername>",
        "regex": true
      },
      {
        "if": "file_exists('server.xml')",
        "type": "alterfile",
        "file": "server.xml",
        "search": "<port>[^<]*</port>",
        "replace": "<port>${port}</port>",
        "regex": true
      },
      {
        "if": "file_exists('server.xml')",
        "type": "alterfile",
        "file": "server.xml",
        "search": "<httpport>[^<]*</httpport>",
        "replace": "<httpport>${port}</httpport>",
        "regex": true
      },
      {
        "if": "file_exists('server.xml')",
        "type": "alterfile",
        "file": "server.xml",
        "search": "<game>[^<]*</game>",
        "replace": "<game>${GAMETYPE}</game>",
        "regex": true
      },
      {
        "if": "file_exists('server.xml')",
        "type": "alterfile",
        "file": "server.xml",
        "search": "<serverbrowser>[^<]*</serverbrowser>",
        "replace": "<serverbrowser>${SERVERBROWSER}</serverbrowser>",
        "regex": true
      }
    ],
    "stdin": {
      "type": "stdin"
    },
    "autostart": false,
    "autorecover": false,
    "autorestart": false
  },
  "environment": {
    "type": "docker",
    "image": "ghcr.io/ptero-eggs/yolks:debian",
    "portBindings": [
      "0.0.0.0:${port}:${port}/tcp",
      "0.0.0.0:${port}:${port}/udp"
    ]
  },
  "supportedEnvironments": [
    {
      "type": "docker",
      "image": "ghcr.io/ptero-eggs/yolks:debian",
      "portBindings": [
        "0.0.0.0:${port}:${port}/tcp",
        "0.0.0.0:${port}:${port}/udp"
      ]
    }
  ],
  "requirements": {
    "os": "linux",
    "arch": "amd64"
  }
}

{
  "type": "automobilista2",
  "display": "Automobilista 2 (Docker)",
  "data": {
    "MAX_PLAYERS": {
      "type": "integer",
      "value": 16,
      "display": "Max Players",
      "desc": "Maximum number of players allowed on the server, up to 32",
      "required": true,
      "userEdit": true
    },
    "QUERY_PORT": {
      "type": "integer",
      "value": 27016,
      "display": "Query Port",
      "desc": "Steam query port",
      "required": true,
      "userEdit": false
    },
    "SERVER_NAME": {
      "type": "string",
      "value": "PufferPanel Server",
      "display": "Server Name",
      "desc": "Name of the server in the server browser",
      "required": true,
      "userEdit": true
    },
    "SERVER_PASSWORD": {
      "type": "string",
      "value": "",
      "display": "Server Password",
      "desc": "Password players must enter to join. Leave blank for a public server.",
      "required": false,
      "userEdit": true
    },
    "SRCDS_APPID": {
      "type": "string",
      "value": "1338040",
      "display": "Steam App ID",
      "desc": "SteamCMD application id of the Automobilista 2 dedicated server (Windows build, run through Wine)",
      "required": true,
      "userEdit": false
    },
    "STEAM_PORT": {
      "type": "integer",
      "value": 8766,
      "display": "Steam Port",
      "desc": "Port used to talk to the Steam network",
      "required": true,
      "userEdit": false
    },
    "UPDATE_ON_BOOT": {
      "type": "boolean",
      "value": true,
      "display": "Update On Boot",
      "desc": "Run SteamCMD before every server start so the server is always up to date",
      "required": false,
      "userEdit": true
    },
    "port": {
      "type": "integer",
      "value": 27015,
      "display": "Host Port",
      "desc": "Port the dedicated server listens on",
      "required": true,
      "userEdit": false
    }
  },
  "install": [
    {
      "type": "mkdir",
      "target": "steamcmd"
    },
    {
      "type": "mkdir",
      "target": "steamapps"
    },
    {
      "type": "download",
      "files": [
        "https://steamcdn-a.akamaihd.net/client/installer/steamcmd_linux.tar.gz"
      ]
    },
    {
      "type": "extract",
      "source": "steamcmd_linux.tar.gz",
      "destination": "steamcmd"
    },
    {
      "type": "command",
      "commands": [
        "./steamcmd/steamcmd.sh +force_install_dir /pufferpanel +login anonymous +@sSteamCmdForcePlatformType windows +app_update ${SRCDS_APPID} validate +quit"
      ]
    },
    {
      "type": "mkdir",
      "target": ".steam/sdk32"
    },
    {
      "type": "mkdir",
      "target": ".steam/sdk64"
    },
    {
      "type": "command",
      "commands": [
        "cp steamcmd/linux32/steamclient.so .steam/sdk32/steamclient.so",
        "cp steamcmd/linux64/steamclient.so .steam/sdk64/steamclient.so",
        "rm -f steamcmd_linux.tar.gz"
      ]
    },
    {
      "if": "!file_exists('server.cfg')",
      "type": "command",
      "commands": [
        "cp config_sample/server_with_lists.cfg server.cfg"
      ]
    },
    {
      "type": "mkdir",
      "target": ".wine"
    },
    {
      "type": "command",
      "commands": [
        "wineboot --init"
      ]
    }
  ],
  "run": {
    "command": "wine ./DedicatedServerCmd.exe",
    "stopCode": 2,
    "environmentVars": {
      "LOGNAME": "container",
      "USER": "container",
      "WINEDEBUG": "-all",
      "WINEDLLOVERRIDES": "mscoree,mshtml=",
      "WINEPREFIX": "/pufferpanel/.wine"
    },
    "pre": [
      {
        "if": "UPDATE_ON_BOOT",
        "type": "command",
        "commands": [
          "./steamcmd/steamcmd.sh +force_install_dir /pufferpanel +login anonymous +@sSteamCmdForcePlatformType windows +app_update ${SRCDS_APPID} +quit"
        ]
      },
      {
        "if": "file_exists('server.cfg')",
        "type": "alterfile",
        "file": "server.cfg",
        "search": "^\\s*name\\s*:.*$",
        "replace": "name : \"${SERVER_NAME}\"",
        "regex": true
      },
      {
        "if": "file_exists('server.cfg')",
        "type": "alterfile",
        "file": "server.cfg",
        "search": "^\\s*steamPort\\s*:.*$",
        "replace": "steamPort : ${STEAM_PORT}",
        "regex": true
      },
      {
        "if": "file_exists('server.cfg')",
        "type": "alterfile",
        "file": "server.cfg",
        "search": "^\\s*hostPort\\s*:.*$",
        "replace": "hostPort : ${port}",
        "regex": true
      },
      {
        "if": "file_exists('server.cfg')",
        "type": "alterfile",
        "file": "server.cfg",
        "search": "^\\s*queryPort\\s*:.*$",
        "replace": "queryPort : ${QUERY_PORT}",
        "regex": true
      },
      {
        "if": "file_exists('server.cfg')",
        "type": "alterfile",
        "file": "server.cfg",
        "search": "^\\s*password\\s*:.*$",
        "replace": "password : \"${SERVER_PASSWORD}\"",
        "regex": true
      },
      {
        "if": "file_exists('server.cfg')",
        "type": "alterfile",
        "file": "server.cfg",
        "search": "^\\s*maxPlayerCount\\s*:.*$",
        "replace": "maxPlayerCount : ${MAX_PLAYERS}",
        "regex": true
      }
    ],
    "stdin": {
      "type": "stdin"
    },
    "autostart": false,
    "autorecover": false,
    "autorestart": false
  },
  "environment": {
    "type": "docker",
    "image": "ghcr.io/ptero-eggs/yolks:wine_latest",
    "portBindings": [
      "0.0.0.0:${port}:${port}/udp",
      "0.0.0.0:${port}:${port}/tcp",
      "0.0.0.0:${QUERY_PORT}:${QUERY_PORT}/udp",
      "0.0.0.0:${STEAM_PORT}:${STEAM_PORT}/udp"
    ]
  },
  "supportedEnvironments": [
    {
      "type": "docker",
      "image": "ghcr.io/ptero-eggs/yolks:wine_latest",
      "portBindings": [
        "0.0.0.0:${port}:${port}/udp",
        "0.0.0.0:${port}:${port}/tcp",
        "0.0.0.0:${QUERY_PORT}:${QUERY_PORT}/udp",
        "0.0.0.0:${STEAM_PORT}:${STEAM_PORT}/udp"
      ]
    }
  ],
  "requirements": {
    "os": "linux",
    "arch": "amd64"
  }
}

{
  "type": "projectzomboid",
  "display": "Project Zomboid (Docker)",
  "data": {
    "ADMIN_PASSWORD": {
      "type": "string",
      "value": "",
      "display": "Admin Password",
      "desc": "Password of the admin account",
      "required": true,
      "userEdit": true
    },
    "ADMIN_USER": {
      "type": "string",
      "value": "admin",
      "display": "Admin Username",
      "desc": "Username of the admin account",
      "required": true,
      "userEdit": true
    },
    "SERVER_NAME": {
      "type": "string",
      "value": "PufferPanel",
      "display": "Server Name",
      "desc": "Internal server name used for the save and config files. Letters and digits only.",
      "required": true,
      "userEdit": true
    },
    "SRCDS_APPID": {
      "type": "string",
      "value": "380870",
      "display": "Steam App ID",
      "desc": "SteamCMD application id of the Project Zomboid dedicated server",
      "required": true,
      "userEdit": false
    },
    "SRCDS_BETAID": {
      "type": "string",
      "value": "",
      "display": "Steam Beta Branch",
      "desc": "Beta branch to install, for example b41multiplayer. Leave empty for the public branch.",
      "required": false,
      "userEdit": true
    },
    "STEAM_PORT": {
      "type": "integer",
      "value": 16262,
      "display": "Steam UDP Port",
      "desc": "Second UDP port used by the Steam networking layer",
      "required": true,
      "userEdit": false
    },
    "UPDATE_ON_BOOT": {
      "type": "boolean",
      "value": false,
      "display": "Update On Boot",
      "desc": "Run SteamCMD before every server start. Off by default because a mid-wipe build change can break an existing save.",
      "required": false,
      "userEdit": true
    },
    "port": {
      "type": "integer",
      "value": 16261,
      "display": "Port",
      "desc": "UDP port the game server binds to",
      "required": true,
      "userEdit": false
    }
  },
  "install": [
    {
      "type": "mkdir",
      "target": "steamcmd"
    },
    {
      "type": "mkdir",
      "target": "steamapps"
    },
    {
      "type": "download",
      "files": [
        "https://steamcdn-a.akamaihd.net/client/installer/steamcmd_linux.tar.gz"
      ]
    },
    {
      "type": "extract",
      "source": "steamcmd_linux.tar.gz",
      "destination": "steamcmd"
    },
    {
      "if": "SRCDS_BETAID == ''",
      "type": "command",
      "commands": [
        "./steamcmd/steamcmd.sh +force_install_dir /pufferpanel +login anonymous +app_update ${SRCDS_APPID} validate +quit"
      ]
    },
    {
      "if": "SRCDS_BETAID != ''",
      "type": "command",
      "commands": [
        "./steamcmd/steamcmd.sh +force_install_dir /pufferpanel +login anonymous +app_update ${SRCDS_APPID} -beta ${SRCDS_BETAID} validate +quit"
      ]
    },
    {
      "type": "mkdir",
      "target": ".steam/sdk32"
    },
    {
      "type": "mkdir",
      "target": ".steam/sdk64"
    },
    {
      "type": "command",
      "commands": [
        "cp steamcmd/linux32/steamclient.so .steam/sdk32/steamclient.so",
        "cp steamcmd/linux64/steamclient.so .steam/sdk64/steamclient.so",
        "rm -f steamcmd_linux.tar.gz"
      ]
    },
    {
      "type": "command",
      "commands": [
        "rm -f start-server.sh",
        "chmod +x ./ProjectZomboid64"
      ]
    },
    {
      "type": "mkdir",
      "target": ".cache"
    }
  ],
  "run": {
    "command": "./ProjectZomboid64 -port ${port} -udpport ${STEAM_PORT} -cachedir=/pufferpanel/.cache -servername ${SERVER_NAME} -adminusername ${ADMIN_USER} -adminpassword ${ADMIN_PASSWORD}",
    "stop": "quit",
    "environmentVars": {
      "PATH": "/pufferpanel/jre64/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin",
      "LD_LIBRARY_PATH": "/pufferpanel/linux64:/pufferpanel/natives:/pufferpanel:/pufferpanel/jre64/lib/amd64",
      "LD_PRELOAD": "libjsig.so"
    },
    "pre": [
      {
        "if": "UPDATE_ON_BOOT && SRCDS_BETAID == ''",
        "type": "command",
        "commands": [
          "./steamcmd/steamcmd.sh +force_install_dir /pufferpanel +login anonymous +app_update ${SRCDS_APPID} +quit"
        ]
      },
      {
        "if": "UPDATE_ON_BOOT && SRCDS_BETAID != ''",
        "type": "command",
        "commands": [
          "./steamcmd/steamcmd.sh +force_install_dir /pufferpanel +login anonymous +app_update ${SRCDS_APPID} -beta ${SRCDS_BETAID} +quit"
        ]
      }
    ],
    "stdin": {
      "type": "stdin"
    },
    "autostart": false,
    "autorecover": false,
    "autorestart": false
  },
  "environment": {
    "type": "docker",
    "image": "ghcr.io/ptero-eggs/steamcmd:debian",
    "portBindings": [
      "0.0.0.0:${port}:${port}/udp",
      "0.0.0.0:${STEAM_PORT}:${STEAM_PORT}/udp"
    ]
  },
  "supportedEnvironments": [
    {
      "type": "docker",
      "image": "ghcr.io/ptero-eggs/steamcmd:debian",
      "portBindings": [
        "0.0.0.0:${port}:${port}/udp",
        "0.0.0.0:${STEAM_PORT}:${STEAM_PORT}/udp"
      ]
    }
  ],
  "requirements": {
    "os": "linux",
    "arch": "amd64"
  }
}

{
  "type": "neosvr",
  "display": "NeosVR (Docker)",
  "data": {
    "ENABLE_MODLOADER": {
      "type": "option",
      "value": "false",
      "display": "Enable Mod Loader",
      "desc": "Load NeosModLoaderHeadless.dll on start",
      "required": true,
      "userEdit": true,
      "options": [
        {
          "value": "false",
          "display": "Disabled"
        },
        {
          "value": "true",
          "display": "Enabled"
        }
      ]
    },
    "SRCDS_APPID": {
      "type": "string",
      "value": "740250",
      "display": "Steam App ID",
      "desc": "SteamCMD application id of the NeosVR headless client dedicated server",
      "required": true,
      "userEdit": false
    },
    "SRCDS_BETAID": {
      "type": "string",
      "value": "headless-client",
      "display": "Beta Branch",
      "desc": "Beta branch holding the headless client",
      "required": true,
      "userEdit": false
    },
    "SRCDS_BETAPASS": {
      "type": "string",
      "value": "",
      "display": "Beta Password",
      "desc": "Password of the beta branch",
      "required": false,
      "userEdit": false
    },
    "STEAM_PASS": {
      "type": "string",
      "value": "",
      "display": "Steam Password",
      "desc": "Password of the Steam account",
      "required": true,
      "userEdit": false
    },
    "STEAM_USER": {
      "type": "string",
      "value": "",
      "display": "Steam Username",
      "desc": "Steam account that owns NeosVR. Anonymous login cannot be used.",
      "required": true,
      "userEdit": false
    },
    "UPDATE_ON_BOOT": {
      "type": "boolean",
      "value": true,
      "display": "Update On Boot",
      "desc": "Run SteamCMD before every server start so the server is always up to date",
      "required": false,
      "userEdit": true
    },
    "port": {
      "type": "integer",
      "value": 9000,
      "display": "Port",
      "desc": "UDP port the headless client listens on",
      "required": true,
      "userEdit": false
    }
  },
  "install": [
    {
      "type": "mkdir",
      "target": "steamcmd"
    },
    {
      "type": "mkdir",
      "target": "steamapps"
    },
    {
      "type": "download",
      "files": [
        "https://steamcdn-a.akamaihd.net/client/installer/steamcmd_linux.tar.gz"
      ]
    },
    {
      "type": "extract",
      "source": "steamcmd_linux.tar.gz",
      "destination": "steamcmd"
    },
    {
      "type": "command",
      "commands": [
        "./steamcmd/steamcmd.sh +force_install_dir /pufferpanel +login ${STEAM_USER} ${STEAM_PASS} +app_update ${SRCDS_APPID} -beta ${SRCDS_BETAID} -betapassword ${SRCDS_BETAPASS} validate +quit"
      ]
    },
    {
      "type": "mkdir",
      "target": ".steam/sdk32"
    },
    {
      "type": "mkdir",
      "target": ".steam/sdk64"
    },
    {
      "type": "mkdir",
      "target": "Config"
    },
    {
      "type": "mkdir",
      "target": "Logs"
    },
    {
      "type": "command",
      "commands": [
        "cp steamcmd/linux32/steamclient.so .steam/sdk32/steamclient.so",
        "cp steamcmd/linux64/steamclient.so .steam/sdk64/steamclient.so",
        "rm -f steamcmd_linux.tar.gz"
      ]
    },
    {
      "if": "!file_exists('Config/Config.json')",
      "type": "download",
      "files": [
        "https://raw.githubusercontent.com/ptero-eggs/game-eggs/main/neosvr/Config.json"
      ]
    },
    {
      "if": "file_exists('Config.json')",
      "type": "move",
      "source": "Config.json",
      "target": "Config/Config.json"
    }
  ],
  "run": {
    "command": [
      {
        "command": "mono Neos.exe -c ./Config/Config.json -l ./Logs -LoadAssembly ./NeosModLoaderHeadless.dll",
        "if": "ENABLE_MODLOADER == 'true'"
      },
      {
        "command": "mono Neos.exe -c ./Config/Config.json -l ./Logs"
      }
    ],
    "stop": "shutdown",
    "pre": [
      {
        "if": "UPDATE_ON_BOOT",
        "type": "command",
        "commands": [
          "./steamcmd/steamcmd.sh +force_install_dir /pufferpanel +login ${STEAM_USER} ${STEAM_PASS} +app_update ${SRCDS_APPID} -beta ${SRCDS_BETAID} -betapassword ${SRCDS_BETAPASS} +quit"
        ]
      }
    ],
    "stdin": {
      "type": "stdin"
    },
    "autostart": false,
    "autorecover": false,
    "autorestart": false
  },
  "environment": {
    "type": "docker",
    "image": "ghcr.io/ptero-eggs/steamcmd:debian",
    "portBindings": [
      "0.0.0.0:${port}:${port}/udp"
    ]
  },
  "supportedEnvironments": [
    {
      "type": "docker",
      "image": "ghcr.io/ptero-eggs/steamcmd:debian",
      "portBindings": [
        "0.0.0.0:${port}:${port}/udp"
      ]
    }
  ],
  "requirements": {
    "os": "linux",
    "arch": "amd64"
  }
}

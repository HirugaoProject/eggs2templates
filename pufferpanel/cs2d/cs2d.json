{
  "type": "cs2d",
  "display": "CS2D (Docker)",
  "data": {
    "CLIENT_URL": {
      "type": "string",
      "value": "https://www.unrealsoftware.de/files_pub/cs2d_linux.zip",
      "display": "CS2D Client Archive URL",
      "desc": "Direct link to the Linux CS2D archive, which supplies the maps, graphics and system files the server needs. The current link is published on https://www.cs2d.com/download.php and changes with every release.",
      "required": true,
      "userEdit": true
    },
    "DEDICATED_URL": {
      "type": "string",
      "value": "https://www.unrealsoftware.de/files_pub/cs2d_dedicated_linux.zip",
      "display": "CS2D Dedicated Server Archive URL",
      "desc": "Direct link to the Linux dedicated server archive",
      "required": true,
      "userEdit": true
    },
    "SERVER_NAME": {
      "type": "string",
      "value": "CS2D Server",
      "display": "Server Name",
      "desc": "Name of the server in the server list",
      "required": true,
      "userEdit": true
    },
    "SERVER_PASSWORD": {
      "type": "string",
      "value": "",
      "display": "Server Password",
      "desc": "Password required to join. Leave blank for an open server.",
      "required": false,
      "userEdit": true
    },
    "SERVER_PLAYERS": {
      "type": "integer",
      "value": 12,
      "display": "Max Players",
      "desc": "Maximum number of players allowed on the server",
      "required": true,
      "userEdit": true
    },
    "port": {
      "type": "integer",
      "value": 36963,
      "display": "Port",
      "desc": "UDP port the server listens on, written to sys/server.cfg as sv_hostport",
      "required": true,
      "userEdit": false
    }
  },
  "install": [
    {
      "type": "command",
      "commands": [
        "curl -sSL -o cs2d_linux.zip ${CLIENT_URL}",
        "curl -sSL -o cs2d_dedicated_linux.zip ${DEDICATED_URL}"
      ]
    },
    {
      "type": "extract",
      "source": "cs2d_linux.zip",
      "destination": "."
    },
    {
      "type": "extract",
      "source": "cs2d_dedicated_linux.zip",
      "destination": "."
    },
    {
      "type": "command",
      "commands": [
        "rm -f cs2d_linux.zip cs2d_dedicated_linux.zip",
        "chmod +x ./cs2d_dedicated"
      ]
    }
  ],
  "run": {
    "command": "./cs2d_dedicated",
    "stopCode": 2,
    "pre": [
      {
        "if": "file_exists('sys/server.cfg')",
        "type": "alterfile",
        "file": "sys/server.cfg",
        "search": "^sv_hostport .*$",
        "replace": "sv_hostport ${port}",
        "regex": true
      },
      {
        "if": "file_exists('sys/server.cfg')",
        "type": "alterfile",
        "file": "sys/server.cfg",
        "search": "^sv_name .*$",
        "replace": "sv_name \"${SERVER_NAME}\"",
        "regex": true
      },
      {
        "if": "file_exists('sys/server.cfg')",
        "type": "alterfile",
        "file": "sys/server.cfg",
        "search": "^sv_password .*$",
        "replace": "sv_password \"${SERVER_PASSWORD}\"",
        "regex": true
      },
      {
        "if": "file_exists('sys/server.cfg')",
        "type": "alterfile",
        "file": "sys/server.cfg",
        "search": "^sv_maxplayers .*$",
        "replace": "sv_maxplayers ${SERVER_PLAYERS}",
        "regex": true
      }
    ],
    "stdin": {
      "type": "stdin"
    },
    "autostart": false,
    "autorecover": false,
    "autorestart": false
  },
  "environment": {
    "type": "docker",
    "image": "ghcr.io/ptero-eggs/games:source",
    "portBindings": [
      "0.0.0.0:${port}:${port}/udp"
    ]
  },
  "supportedEnvironments": [
    {
      "type": "docker",
      "image": "ghcr.io/ptero-eggs/games:source",
      "portBindings": [
        "0.0.0.0:${port}:${port}/udp"
      ]
    }
  ],
  "requirements": {
    "os": "linux",
    "arch": "amd64"
  }
}

{
  "type": "frozenflame",
  "display": "Frozen Flame (Docker)",
  "data": {
    "MAX_PLAYERS": {
      "type": "integer",
      "value": 10,
      "display": "Max Players",
      "desc": "Maximum player count",
      "required": true,
      "userEdit": true
    },
    "QUERY_PORT": {
      "type": "integer",
      "value": 25575,
      "display": "Query Port",
      "desc": "Port used to query the server",
      "required": true,
      "userEdit": false
    },
    "RCON_PASSWORD": {
      "type": "string",
      "value": "",
      "display": "RCON Password",
      "desc": "Password used for RCON",
      "required": false,
      "userEdit": true
    },
    "RCON_PORT": {
      "type": "integer",
      "value": 27015,
      "display": "RCON Port",
      "desc": "Port used for RCON",
      "required": true,
      "userEdit": false
    },
    "SERVER_NAME": {
      "type": "string",
      "value": "My Frozen Flame Server",
      "display": "Server Name",
      "desc": "Name of the server in the server list",
      "required": true,
      "userEdit": true
    },
    "SERVER_PASSWORD": {
      "type": "string",
      "value": "",
      "display": "Server Password",
      "desc": "Password players must enter to join the server",
      "required": false,
      "userEdit": true
    },
    "SRCDS_APPID": {
      "type": "string",
      "value": "1348640",
      "display": "Steam App ID",
      "desc": "SteamCMD application id of the Frozen Flame dedicated server",
      "required": true,
      "userEdit": false
    },
    "UPDATE_ON_BOOT": {
      "type": "boolean",
      "value": true,
      "display": "Update On Boot",
      "desc": "Run SteamCMD before every server start so the server is always up to date",
      "required": false,
      "userEdit": true
    },
    "port": {
      "type": "integer",
      "value": 7777,
      "display": "Game Port",
      "desc": "UDP port the game server binds to",
      "required": true,
      "userEdit": false
    }
  },
  "install": [
    {
      "type": "mkdir",
      "target": "steamcmd"
    },
    {
      "type": "mkdir",
      "target": "steamapps"
    },
    {
      "type": "download",
      "files": [
        "https://steamcdn-a.akamaihd.net/client/installer/steamcmd_linux.tar.gz"
      ]
    },
    {
      "type": "extract",
      "source": "steamcmd_linux.tar.gz",
      "destination": "steamcmd"
    },
    {
      "type": "command",
      "commands": [
        "./steamcmd/steamcmd.sh +force_install_dir /pufferpanel +login anonymous +app_update ${SRCDS_APPID} validate +quit"
      ]
    },
    {
      "type": "mkdir",
      "target": ".steam/sdk32"
    },
    {
      "type": "mkdir",
      "target": ".steam/sdk64"
    },
    {
      "type": "mkdir",
      "target": "FrozenFlame/Saved/Config/LinuxServer"
    },
    {
      "type": "command",
      "commands": [
        "cp steamcmd/linux32/steamclient.so .steam/sdk32/steamclient.so",
        "cp steamcmd/linux64/steamclient.so .steam/sdk64/steamclient.so",
        "rm -f steamcmd_linux.tar.gz",
        "chmod +x ./FrozenFlame/Binaries/Linux/FrozenFlameServer-Linux-Shipping"
      ]
    },
    {
      "if": "!file_exists('FrozenFlame/Saved/Config/LinuxServer/Game.ini')",
      "type": "download",
      "files": [
        "https://raw.githubusercontent.com/DreamsideInteractive/FrozenFlameServer/main/Game.ini"
      ]
    },
    {
      "if": "file_exists('Game.ini')",
      "type": "move",
      "source": "Game.ini",
      "target": "FrozenFlame/Saved/Config/LinuxServer/Game.ini"
    }
  ],
  "run": {
    "command": "./FrozenFlame/Binaries/Linux/FrozenFlameServer-Linux-Shipping -log -MetaGameServerName=${SERVER_NAME} -port=${port} -queryPort=${QUERY_PORT} -RconPort=${RCON_PORT} -RconPassword=${RCON_PASSWORD}",
    "stopCode": 2,
    "pre": [
      {
        "if": "UPDATE_ON_BOOT",
        "type": "command",
        "commands": [
          "./steamcmd/steamcmd.sh +force_install_dir /pufferpanel +login anonymous +app_update ${SRCDS_APPID} +quit"
        ]
      },
      {
        "if": "file_exists('FrozenFlame/Saved/Config/LinuxServer/Game.ini')",
        "type": "alterfile",
        "file": "FrozenFlame/Saved/Config/LinuxServer/Game.ini",
        "search": "^MaxPlayers=.*$",
        "replace": "MaxPlayers=${MAX_PLAYERS}",
        "regex": true
      },
      {
        "if": "file_exists('FrozenFlame/Saved/Config/LinuxServer/Game.ini')",
        "type": "alterfile",
        "file": "FrozenFlame/Saved/Config/LinuxServer/Game.ini",
        "search": "^ServerPassword=.*$",
        "replace": "ServerPassword=\"${SERVER_PASSWORD}\"",
        "regex": true
      }
    ],
    "stdin": {
      "type": "stdin"
    },
    "autostart": false,
    "autorecover": false,
    "autorestart": false
  },
  "environment": {
    "type": "docker",
    "image": "ghcr.io/ptero-eggs/steamcmd:debian",
    "portBindings": [
      "0.0.0.0:${port}:${port}/udp",
      "0.0.0.0:${QUERY_PORT}:${QUERY_PORT}/udp",
      "0.0.0.0:${RCON_PORT}:${RCON_PORT}/tcp"
    ]
  },
  "supportedEnvironments": [
    {
      "type": "docker",
      "image": "ghcr.io/ptero-eggs/steamcmd:debian",
      "portBindings": [
        "0.0.0.0:${port}:${port}/udp",
        "0.0.0.0:${QUERY_PORT}:${QUERY_PORT}/udp",
        "0.0.0.0:${RCON_PORT}:${RCON_PORT}/tcp"
      ]
    }
  ],
  "requirements": {
    "os": "linux",
    "arch": "amd64"
  }
}

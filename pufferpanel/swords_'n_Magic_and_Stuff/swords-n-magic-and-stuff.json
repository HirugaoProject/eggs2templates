{
  "type": "swordsnmagicandstuff",
  "display": "Swords 'n Magic and Stuff (Docker)",
  "data": {
    "QUERY_PORT": {
      "type": "integer",
      "value": 27015,
      "display": "Query Port",
      "desc": "Port Steam clients use to query the server",
      "required": true,
      "userEdit": false
    },
    "SNM_DAYS_UNTIL_RESET": {
      "type": "integer",
      "value": 1,
      "display": "Days Until Reset",
      "desc": "Days between world resets",
      "required": true,
      "userEdit": true
    },
    "SNM_MAX_PLAYERS": {
      "type": "integer",
      "value": 16,
      "display": "Max Players",
      "desc": "Maximum number of players on the server",
      "required": true,
      "userEdit": false
    },
    "SNM_NAME": {
      "type": "string",
      "value": "",
      "display": "Server Name",
      "desc": "Two to five unique words, case insensitive. The approved word list is written to SNM2020/Saved/Logs/Allowed-Words.txt.",
      "required": false,
      "userEdit": true
    },
    "SNM_OWNER_STEAM_ID": {
      "type": "string",
      "value": "",
      "display": "Admin SteamID",
      "desc": "SteamID of the server owner",
      "required": true,
      "userEdit": true
    },
    "SNM_PASSWORD": {
      "type": "string",
      "value": "",
      "display": "Server Password",
      "desc": "Join password. Leave empty for a public server.",
      "required": false,
      "userEdit": true
    },
    "SNM_RESET_TIME_OF_DAY": {
      "type": "string",
      "value": "00:00",
      "display": "Reset Time",
      "desc": "Local time of the reset in 24 hour HH:MM form",
      "required": true,
      "userEdit": true
    },
    "SRCDS_APPID": {
      "type": "string",
      "value": "2058450",
      "display": "Steam App ID",
      "desc": "SteamCMD application id of the Swords 'n Magic and Stuff dedicated server",
      "required": true,
      "userEdit": false
    },
    "UPDATE_ON_BOOT": {
      "type": "boolean",
      "value": true,
      "display": "Update On Boot",
      "desc": "Run SteamCMD before every server start so the server is always up to date",
      "required": false,
      "userEdit": true
    },
    "port": {
      "type": "integer",
      "value": 7777,
      "display": "Port",
      "desc": "UDP port the game server binds to",
      "required": true,
      "userEdit": false
    }
  },
  "install": [
    {
      "type": "mkdir",
      "target": "steamcmd"
    },
    {
      "type": "mkdir",
      "target": "steamapps"
    },
    {
      "type": "download",
      "files": [
        "https://steamcdn-a.akamaihd.net/client/installer/steamcmd_linux.tar.gz"
      ]
    },
    {
      "type": "extract",
      "source": "steamcmd_linux.tar.gz",
      "destination": "steamcmd"
    },
    {
      "type": "command",
      "commands": [
        "./steamcmd/steamcmd.sh +force_install_dir /pufferpanel +login anonymous +@sSteamCmdForcePlatformType windows +app_update ${SRCDS_APPID} validate +quit"
      ]
    },
    {
      "type": "mkdir",
      "target": ".steam/sdk32"
    },
    {
      "type": "mkdir",
      "target": ".steam/sdk64"
    },
    {
      "type": "command",
      "commands": [
        "cp steamcmd/linux32/steamclient.so .steam/sdk32/steamclient.so",
        "cp steamcmd/linux64/steamclient.so .steam/sdk64/steamclient.so",
        "rm -f steamcmd_linux.tar.gz"
      ]
    },
    {
      "type": "mkdir",
      "target": "SNM2020/Saved/Config/WindowsServer"
    },
    {
      "type": "mkdir",
      "target": "SNM2020/Saved/Logs"
    },
    {
      "type": "mkdir",
      "target": ".wine"
    },
    {
      "type": "command",
      "commands": [
        "wineboot --init",
        "winetricks -q vcrun2019"
      ]
    },
    {
      "if": "!file_exists('SNM2020/Saved/Config/WindowsServer/Game.ini')",
      "type": "move",
      "source": "SNM2020/Content/Docs/Dedicated-Server-Game.ini",
      "target": "SNM2020/Saved/Config/WindowsServer/Game.ini"
    }
  ],
  "run": {
    "command": "wine /pufferpanel/SNM2020/Binaries/Win64/SNMASServer-Win64-Shipping.exe -port=${port} -QueryPort=${QUERY_PORT} -log",
    "stopCode": 2,
    "environmentVars": {
      "DISPLAY": ":0",
      "LOGNAME": "container",
      "USER": "container",
      "WINEDEBUG": "-all",
      "WINEDLLOVERRIDES": "mscoree,mshtml=",
      "WINEPREFIX": "/pufferpanel/.wine",
      "WINEARCH": "win64"
    },
    "pre": [
      {
        "if": "UPDATE_ON_BOOT",
        "type": "command",
        "commands": [
          "./steamcmd/steamcmd.sh +force_install_dir /pufferpanel +login anonymous +@sSteamCmdForcePlatformType windows +app_update ${SRCDS_APPID} +quit"
        ]
      },
      {
        "if": "file_exists('SNM2020/Saved/Config/WindowsServer/Game.ini')",
        "type": "alterfile",
        "file": "SNM2020/Saved/Config/WindowsServer/Game.ini",
        "search": "^ServerName=.*$",
        "replace": "ServerName=${SNM_NAME}",
        "regex": true
      },
      {
        "if": "file_exists('SNM2020/Saved/Config/WindowsServer/Game.ini')",
        "type": "alterfile",
        "file": "SNM2020/Saved/Config/WindowsServer/Game.ini",
        "search": "^ServerPassword=.*$",
        "replace": "ServerPassword=${SNM_PASSWORD}",
        "regex": true
      },
      {
        "if": "file_exists('SNM2020/Saved/Config/WindowsServer/Game.ini')",
        "type": "alterfile",
        "file": "SNM2020/Saved/Config/WindowsServer/Game.ini",
        "search": "^OwnerSteamID=.*$",
        "replace": "OwnerSteamID=${SNM_OWNER_STEAM_ID}",
        "regex": true
      },
      {
        "if": "file_exists('SNM2020/Saved/Config/WindowsServer/Game.ini')",
        "type": "alterfile",
        "file": "SNM2020/Saved/Config/WindowsServer/Game.ini",
        "search": "^MaxPlayers=.*$",
        "replace": "MaxPlayers=${SNM_MAX_PLAYERS}",
        "regex": true
      },
      {
        "if": "file_exists('SNM2020/Saved/Config/WindowsServer/Game.ini')",
        "type": "alterfile",
        "file": "SNM2020/Saved/Config/WindowsServer/Game.ini",
        "search": "^DaysUntilReset=.*$",
        "replace": "DaysUntilReset=${SNM_DAYS_UNTIL_RESET}",
        "regex": true
      },
      {
        "if": "file_exists('SNM2020/Saved/Config/WindowsServer/Game.ini')",
        "type": "alterfile",
        "file": "SNM2020/Saved/Config/WindowsServer/Game.ini",
        "search": "^ResetTimeOfDay=.*$",
        "replace": "ResetTimeOfDay=${SNM_RESET_TIME_OF_DAY}",
        "regex": true
      }
    ],
    "stdin": {
      "type": "stdin"
    },
    "autostart": false,
    "autorecover": false,
    "autorestart": false
  },
  "environment": {
    "type": "docker",
    "image": "ghcr.io/ptero-eggs/yolks:wine_latest",
    "portBindings": [
      "0.0.0.0:${port}:${port}/udp",
      "0.0.0.0:${QUERY_PORT}:${QUERY_PORT}/udp"
    ]
  },
  "supportedEnvironments": [
    {
      "type": "docker",
      "image": "ghcr.io/ptero-eggs/yolks:wine_latest",
      "portBindings": [
        "0.0.0.0:${port}:${port}/udp",
        "0.0.0.0:${QUERY_PORT}:${QUERY_PORT}/udp"
      ]
    }
  ],
  "requirements": {
    "os": "linux",
    "arch": "amd64"
  }
}

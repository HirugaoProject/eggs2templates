      },
      {
        "if": "file_exists('TSSGame/GameServerSettings.ini')",
        "type": "alterfile",
        "file": "TSSGame/GameServerSettings.ini",
        "search": "^PickupRespawnTimer=.*$",
        "replace": "PickupRespawnTimer=${PICKUP_RESPAWN_TIMER}",
        "regex": true
      },
      {
        "if": "file_exists('TSSGame/GameServerSettings.ini')",
        "type": "alterfile",
        "file": "TSSGame/GameServerSettings.ini",
        "search": "^LootRarity=.*$",
        "replace": "LootRarity=${LOOT_RARITY}",
        "regex": true
      },
      {
        "if": "file_exists('TSSGame/GameServerSettings.ini')",
        "type": "alterfile",
        "file": "TSSGame/GameServerSettings.ini",
        "search": "^AirDropInterval=.*$",
        "replace": "AirDropInterval=${AIR_DROP_INTERVAL}",
        "regex": true
      },
      {
        "if": "file_exists('TSSGame/GameServerSettings.ini')",
        "type": "alterfile",
        "file": "TSSGame/GameServerSettings.ini",
        "search": "^ZombieDiffHealth=.*$",
        "replace": "ZombieDiffHealth=${ZOMBIE_DIFF_HEALTH}",
        "regex": true
      },
      {
        "if": "file_exists('TSSGame/GameServerSettings.ini')",
        "type": "alterfile",
        "file": "TSSGame/GameServerSettings.ini",
        "search": "^ZombieDiffSpeed=.*$",
        "replace": "ZombieDiffSpeed=${ZOMBIE_DIFF_SPEED}",

  "install": [
    {
      "type": "mkdir",
      "target": "steamcmd"
    },
    {
      "type": "mkdir",
      "target": "steamapps"
    },
    {
      "type": "download",
      "files": [
        "https://steamcdn-a.akamaihd.net/client/installer/steamcmd_linux.tar.gz"
      ]
    },
    {
      "type": "extract",
      "source": "steamcmd_linux.tar.gz",
      "destination": "steamcmd"
    },
    {
      "type": "command",
      "commands": [
        "./steamcmd/steamcmd.sh +force_install_dir /pufferpanel +login anonymous +app_update ${SRCDS_APPID} -beta ${SRCDS_BETAID} validate +quit"
      ]
    },
    {
      "type": "mkdir",
      "target": ".steam/sdk32"
    },
    {
      "type": "mkdir",
      "target": ".steam/sdk64"
    },
    {
      "type": "command",
      "commands": [
        "cp steamcmd/linux32/steamclient.so .steam/sdk32/steamclient.so",
        "cp steamcmd/linux64/steamclient.so .steam/sdk64/steamclient.so",
        "rm -f steamcmd_linux.tar.gz",
        "chmod +x ./TSSGame/Binaries/Linux/TSSGameServer-Linux-Shipping"
      ]
    },
    {
      "type": "mkdir",
      "target": "TSSGame"
    },
    {
      "if": "!file_exists('TSSGame/GameServerSettings.ini')",
      "type": "writefile",
      "target": "TSSGame/GameServerSettings.ini",
      "text": "[Host Settings]\nServerName=${SERVER_NAME}\nPassword=${PASSWORD}\nSaveName=${SAVE_NAME}\nAdminPass=${ADMIN_PASS}\nMaxPlayers=${MAX_PLAYERS}\nOnlyAllowedPlayers=${ONLY_ALLOWED_PLAYERS}\n\n[World Settings]\nSaveIntervalSec=${SAVE_INTERVAL_SEC}\nNoDeathFeedback=${NO_DEATH_FEEDBACK}\nPermaDeath=${PERMA_DEATH}\nOnDeath=${ON_DEATH}\nPVP=${PVP}\nClearInfection=${CLEAR_INFECTION}\nEagleEye=${EAGLE_EYE}\nAirDrop=${AIR_DROP}\nWeaponBreak=${WEAPON_BREAK}\nMultiplayerSleep=${MULTIPLAYER_SLEEP}\nLootRespawn=${LOOT_RESPAWN}\nLootRespawnTimer=${LOOT_RESPAWN_TIMER}\nPickupRespawnTimer=${PICKUP_RESPAWN_TIMER}\nLootRarity=${LOOT_RARITY}\nAirDropInterval=${AIR_DROP_INTERVAL}\nZombieDiffHealth=${ZOMBIE_DIFF_HEALTH}\nZombieDiffSpeed=${ZOMBIE_DIFF_SPEED}\nZombieDiffDamage=${ZOMBIE_DIFF_DAMAGE}\nHumanDifficulty=${HUMAN_DIFFICULTY}\nZombieAmountMulti=${ZOMBIE_AMOUNT_MULTI}\nHumanAmountMulti=${HUMAN_AMOUNT_MULTI}\nZombieDogMulti=${ZOMBIE_DOG_MULTI}\nZombieRespawnTimer=${ZOMBIE_RESPAWN_TIMER}\nHumanRespawnTimer=${HUMAN_RESPAWN_TIMER}\nAnimalRespawnTimer=${ANIMAL_RESPAWN_TIMER}\nStartingSeason=${STARTING_SEASON}\nDaysPerSeason=${DAYS_PER_SEASON}\nDayDur=${DAY_DUR}\nNightDur=${NIGHT_DUR}\nVitalDrain=${VITAL_DRAIN}\nDogEnabled=${DOG_ENABLED}\nDogNum=${DOG_NUM}\nRecruitDog=${RECRUIT_DOG}\nBuildingHealth=${BUILDING_HEALTH}\nCompanionHealth=${COMPANION_HEALTH}\nCompanionDmg=${COMPANION_DMG}\nAllowDismantle=${ALLOW_DISMANTLE}\nAllowHouseDismantle=${ALLOW_HOUSE_DISMANTLE}\nTerritory=${TERRITORY}\nDecay=${DECAY}\nPickupCleanup=${PICKUP_CLEANUP}\nFakeBuildingCleanup=${FAKE_BUILDING_CLEANUP}\n"
    }
  ],
  "run": {
    "command": "./TSSGame/Binaries/Linux/TSSGameServer-Linux-Shipping TSSGame -log -port=${port} -queryport=${QUERY_PORT} -steamservername=\"${SERVER_NAME}\"",
    "stopCode": 2,
    "pre": [
      {
        "if": "UPDATE_ON_BOOT",
        "type": "command",
        "commands": [
          "./steamcmd/steamcmd.sh +force_install_dir /pufferpanel +login anonymous +app_update ${SRCDS_APPID} -beta ${SRCDS_BETAID} +quit"
        ]
      },
      {
        "if": "file_exists('TSSGame/GameServerSettings.ini')",
        "type": "alterfile",
        "file": "TSSGame/GameServerSettings.ini",
        "search": "^ServerName=.*$",
        "replace": "ServerName=${SERVER_NAME}",
        "regex": true
      },
      {
        "if": "file_exists('TSSGame/GameServerSettings.ini')",
        "type": "alterfile",
        "file": "TSSGame/GameServerSettings.ini",
        "search": "^Password=.*$",
        "replace": "Password=${PASSWORD}",
        "regex": true
      },
      {
        "if": "file_exists('TSSGame/GameServerSettings.ini')",
        "type": "alterfile",
        "file": "TSSGame/GameServerSettings.ini",
        "search": "^SaveName=.*$",
        "replace": "SaveName=${SAVE_NAME}",
        "regex": true
      },
      {
        "if": "file_exists('TSSGame/GameServerSettings.ini')",
        "type": "alterfile",
        "file": "TSSGame/GameServerSettings.ini",
        "search": "^AdminPass=.*$",
        "replace": "AdminPass=${ADMIN_PASS}",
        "regex": true
      },
      {
        "if": "file_exists('TSSGame/GameServerSettings.ini')",
        "type": "alterfile",
        "file": "TSSGame/GameServerSettings.ini",
        "search": "^MaxPlayers=.*$",
        "replace": "MaxPlayers=${MAX_PLAYERS}",
        "regex": true
      },
      {
        "if": "file_exists('TSSGame/GameServerSettings.ini')",
        "type": "alterfile",
        "file": "TSSGame/GameServerSettings.ini",
        "search": "^OnlyAllowedPlayers=.*$",
        "replace": "OnlyAllowedPlayers=${ONLY_ALLOWED_PLAYERS}",
        "regex": true
      },
      {
        "if": "file_exists('TSSGame/GameServerSettings.ini')",
        "type": "alterfile",
        "file": "TSSGame/GameServerSettings.ini",
        "search": "^SaveIntervalSec=.*$",
        "replace": "SaveIntervalSec=${SAVE_INTERVAL_SEC}",
        "regex": true
      },
      {
        "if": "file_exists('TSSGame/GameServerSettings.ini')",
        "type": "alterfile",
        "file": "TSSGame/GameServerSettings.ini",
        "search": "^NoDeathFeedback=.*$",
        "replace": "NoDeathFeedback=${NO_DEATH_FEEDBACK}",
        "regex": true
      },
      {
        "if": "file_exists('TSSGame/GameServerSettings.ini')",
        "type": "alterfile",
        "file": "TSSGame/GameServerSettings.ini",
        "search": "^PermaDeath=.*$",
        "replace": "PermaDeath=${PERMA_DEATH}",
        "regex": true
      },
      {
        "if": "file_exists('TSSGame/GameServerSettings.ini')",
        "type": "alterfile",
        "file": "TSSGame/GameServerSettings.ini",
        "search": "^OnDeath=.*$",
        "replace": "OnDeath=${ON_DEATH}",
        "regex": true
      },
      {
        "if": "file_exists('TSSGame/GameServerSettings.ini')",
        "type": "alterfile",
        "file": "TSSGame/GameServerSettings.ini",
        "search": "^PVP=.*$",
        "replace": "PVP=${PVP}",
        "regex": true
      },
      {
        "if": "file_exists('TSSGame/GameServerSettings.ini')",
        "type": "alterfile",
        "file": "TSSGame/GameServerSettings.ini",
        "search": "^ClearInfection=.*$",
        "replace": "ClearInfection=${CLEAR_INFECTION}",
        "regex": true
      },
      {
        "if": "file_exists('TSSGame/GameServerSettings.ini')",
        "type": "alterfile",
        "file": "TSSGame/GameServerSettings.ini",
        "search": "^EagleEye=.*$",
        "replace": "EagleEye=${EAGLE_EYE}",
        "regex": true
      },
      {
        "if": "file_exists('TSSGame/GameServerSettings.ini')",
        "type": "alterfile",
        "file": "TSSGame/GameServerSettings.ini",
        "search": "^AirDrop=.*$",
        "replace": "AirDrop=${AIR_DROP}",
        "regex": true
      },
      {
        "if": "file_exists('TSSGame/GameServerSettings.ini')",
        "type": "alterfile",
        "file": "TSSGame/GameServerSettings.ini",
        "search": "^WeaponBreak=.*$",
        "replace": "WeaponBreak=${WEAPON_BREAK}",
        "regex": true
      },
      {
        "if": "file_exists('TSSGame/GameServerSettings.ini')",

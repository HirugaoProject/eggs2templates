{
  "type": "deadmatter",
  "display": "Dead Matter (Docker)",
  "data": {
    "QUERY_PORT": {
      "type": "integer",
      "value": 7002,
      "display": "Query Port",
      "desc": "Steam query port",
      "required": true,
      "userEdit": false
    },
    "SERVER_NAME": {
      "type": "string",
      "value": "A PufferPanel hosted server",
      "display": "Server Name",
      "desc": "Name of the server in the server browser",
      "required": true,
      "userEdit": true
    },
    "SRCDS_APPID": {
      "type": "string",
      "value": "2584780",
      "display": "Steam App ID",
      "desc": "SteamCMD application id of the Dead Matter dedicated server (Windows build, run through Proton)",
      "required": true,
      "userEdit": false
    },
    "UPDATE_ON_BOOT": {
      "type": "boolean",
      "value": true,
      "display": "Update On Boot",
      "desc": "Run SteamCMD before every server start so the server is always up to date",
      "required": false,
      "userEdit": true
    },
    "port": {
      "type": "integer",
      "value": 7000,
      "display": "Game Port",
      "desc": "UDP port the game server binds to",
      "required": true,
      "userEdit": false
    }
  },
  "install": [
    {
      "type": "mkdir",
      "target": "steamcmd"
    },
    {
      "type": "mkdir",
      "target": "steamapps"
    },
    {
      "type": "download",
      "files": [
        "https://steamcdn-a.akamaihd.net/client/installer/steamcmd_linux.tar.gz"
      ]
    },
    {
      "type": "extract",
      "source": "steamcmd_linux.tar.gz",
      "destination": "steamcmd"
    },
    {
      "type": "command",
      "commands": [
        "./steamcmd/steamcmd.sh +force_install_dir /pufferpanel +login anonymous +@sSteamCmdForcePlatformType windows +app_update ${SRCDS_APPID} validate +quit"
      ]
    },
    {
      "type": "mkdir",
      "target": ".steam/sdk32"
    },
    {
      "type": "mkdir",
      "target": ".steam/sdk64"
    },
    {
      "type": "mkdir",
      "target": ".steam/steam/steamapps/compatdata/${SRCDS_APPID}"
    },
    {
      "type": "mkdir",
      "target": "DeadMatter/Saved/Config/WindowsServer"
    },
    {
      "type": "mkdir",
      "target": "DeadMatter/Saved/Logs"
    },
    {
      "type": "command",
      "commands": [
        "cp steamcmd/linux32/steamclient.so .steam/sdk32/steamclient.so",
        "cp steamcmd/linux64/steamclient.so .steam/sdk64/steamclient.so",
        "rm -f steamcmd_linux.tar.gz"
      ]
    },
    {
      "type": "writefile",
      "target": "steam_appid.txt",
      "text": "2184150\n"
    }
  ],
  "run": {
    "command": "proton run DeadMatter/Binaries/Win64/DeadMatterServer-Win64-Test.exe -SteamServerName=\"${SERVER_NAME}\" -port=${port} -queryport=${QUERY_PORT} -log",
    "stopCode": 2,
    "environmentVars": {
      "STEAM_COMPAT_CLIENT_INSTALL_PATH": "/pufferpanel/.steam/steam",
      "STEAM_COMPAT_DATA_PATH": "/pufferpanel/.steam/steam/steamapps/compatdata/${SRCDS_APPID}",
      "WINEDEBUG": "-all"
    },
    "pre": [
      {
        "if": "UPDATE_ON_BOOT",
        "type": "command",
        "commands": [
          "./steamcmd/steamcmd.sh +force_install_dir /pufferpanel +login anonymous +@sSteamCmdForcePlatformType windows +app_update ${SRCDS_APPID} +quit"
        ]
      },
      {
        "type": "mkdir",
        "target": ".steam/steam/steamapps/compatdata/${SRCDS_APPID}"
      }
    ],
    "stdin": {
      "type": "stdin"
    },
    "autostart": false,
    "autorecover": false,
    "autorestart": false
  },
  "environment": {
    "type": "docker",
    "image": "ghcr.io/ptero-eggs/steamcmd:proton",
    "portBindings": [
      "0.0.0.0:${port}:${port}/udp",
      "0.0.0.0:${QUERY_PORT}:${QUERY_PORT}/udp"
    ]
  },
  "supportedEnvironments": [
    {
      "type": "docker",
      "image": "ghcr.io/ptero-eggs/steamcmd:proton",
      "portBindings": [
        "0.0.0.0:${port}:${port}/udp",
        "0.0.0.0:${QUERY_PORT}:${QUERY_PORT}/udp"
      ]
    }
  ],
  "requirements": {
    "os": "linux",
    "arch": "amd64"
  }
}

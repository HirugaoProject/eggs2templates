{
  "type": "srcds",
  "display": "Half-Life 2: Deathmatch (Docker)",
  "data": {
    "MAP_NAME": {
      "type": "string",
      "value": "dm_lockdown",
      "display": "Map Name",
      "desc": "Map the server loads on boot",
      "required": true,
      "userEdit": true
    },
    "MAX_PLAYERS": {
      "type": "integer",
      "value": 20,
      "display": "Max Players",
      "desc": "Maximum number of players allowed",
      "required": true,
      "userEdit": true
    },
    "RCON_PASSWORD": {
      "type": "string",
      "value": "ChangeMe",
      "display": "RCON Password",
      "desc": "Password used for the server RCON",
      "required": true,
      "userEdit": true
    },
    "SERVER_NAME": {
      "type": "string",
      "value": "PufferPanel-server",
      "display": "Server Name",
      "desc": "Name of the server in the server browser",
      "required": true,
      "userEdit": true
    },
    "SERVER_PASSWORD": {
      "type": "string",
      "value": "",
      "display": "Server Password",
      "desc": "Password used to join the server",
      "required": false,
      "userEdit": true
    },
    "SRCDS_APPID": {
      "type": "string",
      "value": "232370",
      "display": "Steam App ID",
      "desc": "SteamCMD application id of the Half-Life 2: Deathmatch dedicated server",
      "required": true,
      "userEdit": false
    },
    "TICK_RATE": {
      "type": "integer",
      "value": 66,
      "display": "Tick Rate",
      "desc": "Server tick rate",
      "required": true,
      "userEdit": true
    },
    "UPDATE_ON_BOOT": {
      "type": "boolean",
      "value": true,
      "display": "Update On Boot",
      "desc": "Run SteamCMD before every server start so the server is always up to date",
      "required": false,
      "userEdit": true
    },
    "port": {
      "type": "integer",
      "value": 27015,
      "display": "Port",
      "desc": "Port the server binds to",
      "required": true,
      "userEdit": false
    }
  },
  "install": [
    {
      "type": "mkdir",
      "target": "steamcmd"
    },
    {
      "type": "mkdir",
      "target": "steamapps"
    },
    {
      "type": "download",
      "files": [
        "https://steamcdn-a.akamaihd.net/client/installer/steamcmd_linux.tar.gz"
      ]
    },
    {
      "type": "extract",
      "source": "steamcmd_linux.tar.gz",
      "destination": "steamcmd"
    },
    {
      "type": "command",
      "commands": [
        "./steamcmd/steamcmd.sh +force_install_dir /pufferpanel +login anonymous +app_update ${SRCDS_APPID} validate +quit"
      ]
    },
    {
      "type": "mkdir",
      "target": ".steam/sdk32"
    },
    {
      "type": "mkdir",
      "target": ".steam/sdk64"
    },
    {
      "type": "mkdir",
      "target": "hl2mp/cfg"
    },
    {
      "type": "command",
      "commands": [
        "cp steamcmd/linux32/steamclient.so .steam/sdk32/steamclient.so",
        "cp steamcmd/linux64/steamclient.so .steam/sdk64/steamclient.so",
        "rm -f steamcmd_linux.tar.gz",
        "chmod +x ./srcds_run"
      ]
    },
    {
      "if": "!file_exists('hl2mp/cfg/server.cfg')",
      "type": "writefile",
      "target": "hl2mp/cfg/server.cfg",
      "text": "// Basic server settings\nhostname \"${SERVER_NAME}\"\nsv_password \"${SERVER_PASSWORD}\"\nrcon_password \"${RCON_PASSWORD}\"\nsv_cheats 0\nsv_lan 0\nsv_region 255\nmp_disable_autokick 0\n\n// Gameplay settings\nsv_hl2mp_weapon_respawn_time 20\nsv_hl2mp_item_respawn_time 30\nmp_weaponstay 0\nmp_autocrosshair 1\nsv_alltalk 1\nmp_allowspectators 1\nsv_voiceenable 1\nmp_forcerespawn 1\nmp_timelimit 20\nmp_winlimit 0\nmp_maxrounds 0\nmp_teams_unbalance_limit 0\nmp_friendlyfire 0\nmp_flashlight 1\nmp_autoteambalance 0\n\n// Player settings\nsv_timeout 60\n"
    }
  ],
  "run": {
    "command": "./srcds_run -console -game hl2mp -maxplayers ${MAX_PLAYERS} +map ${MAP_NAME} -port ${port} -tickrate ${TICK_RATE} +ip 0.0.0.0 -strictportbind -norestart",
    "stop": "quit",
    "pre": [
      {
        "if": "UPDATE_ON_BOOT",
        "type": "command",
        "commands": [
          "./steamcmd/steamcmd.sh +force_install_dir /pufferpanel +login anonymous +app_update ${SRCDS_APPID} +quit"
        ]
      },
      {
        "if": "file_exists('hl2mp/cfg/server.cfg')",
        "type": "alterfile",
        "file": "hl2mp/cfg/server.cfg",
        "search": "^hostname .*$",
        "replace": "hostname \"${SERVER_NAME}\"",
        "regex": true
      },
      {
        "if": "file_exists('hl2mp/cfg/server.cfg')",
        "type": "alterfile",
        "file": "hl2mp/cfg/server.cfg",
        "search": "^sv_password .*$",
        "replace": "sv_password \"${SERVER_PASSWORD}\"",
        "regex": true
      },
      {
        "if": "file_exists('hl2mp/cfg/server.cfg')",
        "type": "alterfile",
        "file": "hl2mp/cfg/server.cfg",
        "search": "^rcon_password .*$",
        "replace": "rcon_password \"${RCON_PASSWORD}\"",
        "regex": true
      }
    ],
    "stdin": {
      "type": "stdin"
    },
    "autostart": false,
    "autorecover": false,
    "autorestart": false
  },
  "environment": {
    "type": "docker",
    "image": "ghcr.io/ptero-eggs/steamcmd:debian",
    "portBindings": [
      "0.0.0.0:${port}:${port}/tcp",
      "0.0.0.0:${port}:${port}/udp"
    ]
  },
  "supportedEnvironments": [
    {
      "type": "docker",
      "image": "ghcr.io/ptero-eggs/steamcmd:debian",
      "portBindings": [
        "0.0.0.0:${port}:${port}/tcp",
        "0.0.0.0:${port}:${port}/udp"
      ]
    }
  ],
  "requirements": {
    "os": "linux",
    "arch": "amd64"
  }
}

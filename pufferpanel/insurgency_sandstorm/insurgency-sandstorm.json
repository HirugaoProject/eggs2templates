{
  "type": "insurgency",
  "display": "Insurgency: Sandstorm (Docker)",
  "data": {
    "ADDSWITCHES": {
      "type": "string",
      "value": "",
      "display": "Additional Switches",
      "desc": "Extra command line switches, see https://mod.io/g/insurgency",
      "required": false,
      "userEdit": true
    },
    "GSLTT": {
      "type": "string",
      "value": "",
      "display": "GSLT Authentication",
      "desc": "Game server login token, generated at https://steamcommunity.com/dev/managegameservers",
      "required": false,
      "userEdit": true
    },
    "GST": {
      "type": "string",
      "value": "",
      "display": "Game Stats Token",
      "desc": "Token generated at https://gamestats.sandstorm.game/, required for stats to count",
      "required": false,
      "userEdit": true
    },
    "HOSTNAME": {
      "type": "string",
      "value": "My Insurgency Server",
      "display": "Server Name",
      "desc": "Name shown in the server list",
      "required": true,
      "userEdit": true
    },
    "MAP_NAME": {
      "type": "string",
      "value": "Canyon",
      "display": "Default Map",
      "desc": "Map loaded on start. The scenario has to be available on this map.",
      "required": true,
      "userEdit": true
    },
    "MAX_PLAYERS": {
      "type": "integer",
      "value": 28,
      "display": "Max Players",
      "desc": "Maximum number of players",
      "required": true,
      "userEdit": true
    },
    "QUERY_PORT": {
      "type": "integer",
      "value": 27131,
      "display": "Query Port",
      "desc": "Query port of the server",
      "required": true,
      "userEdit": false
    },
    "SCENARIO": {
      "type": "string",
      "value": "Scenario_Crossing_Checkpoint_Insurgents",
      "display": "Scenario Name",
      "desc": "Scenario the server starts. Without one the server cycles all versus scenarios.",
      "required": true,
      "userEdit": true
    },
    "SRCDS_APPID": {
      "type": "string",
      "value": "581330",
      "display": "Steam App ID",
      "desc": "SteamCMD application id of the Insurgency: Sandstorm dedicated server",
      "required": true,
      "userEdit": false
    },
    "UPDATE_ON_BOOT": {
      "type": "boolean",
      "value": true,
      "display": "Update On Boot",
      "desc": "Run SteamCMD before every server start so the server is always up to date",
      "required": false,
      "userEdit": true
    },
    "port": {
      "type": "integer",
      "value": 27102,
      "display": "Port",
      "desc": "UDP port the game server binds to",
      "required": true,
      "userEdit": false
    }
  },
  "install": [
    {
      "type": "mkdir",
      "target": "steamcmd"
    },
    {
      "type": "mkdir",
      "target": "steamapps"
    },
    {
      "type": "download",
      "files": [
        "https://steamcdn-a.akamaihd.net/client/installer/steamcmd_linux.tar.gz"
      ]
    },
    {
      "type": "extract",
      "source": "steamcmd_linux.tar.gz",
      "destination": "steamcmd"
    },
    {
      "type": "command",
      "commands": [
        "./steamcmd/steamcmd.sh +force_install_dir /pufferpanel +login anonymous +app_update ${SRCDS_APPID} validate +quit"
      ]
    },
    {
      "type": "mkdir",
      "target": ".steam/sdk32"
    },
    {
      "type": "mkdir",
      "target": ".steam/sdk64"
    },
    {
      "type": "command",
      "commands": [
        "cp steamcmd/linux32/steamclient.so .steam/sdk32/steamclient.so",
        "cp steamcmd/linux64/steamclient.so .steam/sdk64/steamclient.so",
        "rm -f steamcmd_linux.tar.gz"
      ]
    },
    {
      "type": "command",
      "commands": [
        "chmod +x ./Insurgency/Binaries/Linux/InsurgencyServer-Linux-Shipping"
      ]
    }
  ],
  "run": {
    "command": "./Insurgency/Binaries/Linux/InsurgencyServer-Linux-Shipping ${MAP_NAME}?Scenario=${SCENARIO}?MaxPlayers=${MAX_PLAYERS} -Port=${port} -QueryPort=${QUERY_PORT} -log -hostname=\"${HOSTNAME}\" -GSLTToken=${GSLTT} -GameStats -GameStatsToken=${GST} ${ADDSWITCHES}",
    "stopCode": 2,
    "pre": [
      {
        "if": "UPDATE_ON_BOOT",
        "type": "command",
        "commands": [
          "./steamcmd/steamcmd.sh +force_install_dir /pufferpanel +login anonymous +app_update ${SRCDS_APPID} +quit"
        ]
      }
    ],
    "stdin": {
      "type": "stdin"
    },
    "autostart": false,
    "autorecover": false,
    "autorestart": false
  },
  "environment": {
    "type": "docker",
    "image": "ghcr.io/ptero-eggs/steamcmd:ubuntu",
    "portBindings": [
      "0.0.0.0:${port}:${port}/udp",
      "0.0.0.0:${QUERY_PORT}:${QUERY_PORT}/udp"
    ]
  },
  "supportedEnvironments": [
    {
      "type": "docker",
      "image": "ghcr.io/ptero-eggs/steamcmd:ubuntu",
      "portBindings": [
        "0.0.0.0:${port}:${port}/udp",
        "0.0.0.0:${QUERY_PORT}:${QUERY_PORT}/udp"
      ]
    }
  ],
  "requirements": {
    "os": "linux",
    "arch": "amd64"
  }
}

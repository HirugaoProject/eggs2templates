{
  "type": "aapg",
  "display": "America's Army: Proving Grounds (Docker)",
  "data": {
    "AUTH_PORT": {
      "type": "integer",
      "value": 7780,
      "display": "Auth Port",
      "desc": "Steam authentication port",
      "required": true,
      "userEdit": false
    },
    "QUERY_PORT": {
      "type": "integer",
      "value": 27015,
      "display": "Query Port",
      "desc": "Steam query port",
      "required": true,
      "userEdit": false
    },
    "SERVER_NAME": {
      "type": "string",
      "value": "A PufferPanel Server",
      "display": "Server Name",
      "desc": "Name of the server as shown in the server browser",
      "required": true,
      "userEdit": true
    },
    "SRCDS_APPID": {
      "type": "string",
      "value": "203300",
      "display": "Steam App ID",
      "desc": "SteamCMD application id of the America's Army: Proving Grounds dedicated server",
      "required": true,
      "userEdit": false
    },
    "UPDATE_ON_BOOT": {
      "type": "boolean",
      "value": true,
      "display": "Update On Boot",
      "desc": "Run SteamCMD before every server start so the server is always up to date",
      "required": false,
      "userEdit": true
    },
    "port": {
      "type": "integer",
      "value": 8777,
      "display": "Game Port",
      "desc": "UDP port the game server binds to",
      "required": true,
      "userEdit": false
    }
  },
  "groups": [
    {
      "display": "Server",
      "description": "General server settings",
      "variables": [
        "SERVER_NAME",
        "port",
        "QUERY_PORT",
        "AUTH_PORT"
      ],
      "order": 1
    },
    {
      "display": "SteamCMD",
      "description": "Installation and update settings",
      "variables": [
        "SRCDS_APPID",
        "UPDATE_ON_BOOT"
      ],
      "order": 2
    }
  ],
  "install": [
    {
      "type": "mkdir",
      "target": "steamcmd"
    },
    {
      "type": "mkdir",
      "target": "steamapps"
    },
    {
      "type": "download",
      "files": [
        "https://steamcdn-a.akamaihd.net/client/installer/steamcmd_linux.tar.gz"
      ]
    },
    {
      "type": "extract",
      "source": "steamcmd_linux.tar.gz",
      "destination": "steamcmd"
    },
    {
      "type": "command",
      "commands": [
        "./steamcmd/steamcmd.sh +force_install_dir /pufferpanel +login anonymous +app_update ${SRCDS_APPID} validate +quit"
      ]
    },
    {
      "type": "mkdir",
      "target": ".steam/sdk32"
    },
    {
      "type": "mkdir",
      "target": ".steam/sdk64"
    },
    {
      "type": "command",
      "commands": [
        "cp steamcmd/linux32/steamclient.so .steam/sdk32/steamclient.so",
        "cp steamcmd/linux64/steamclient.so .steam/sdk64/steamclient.so",
        "rm -f steamcmd_linux.tar.gz",
        "chmod +x ./Binaries/Linux/AAPG"
      ]
    }
  ],
  "run": {
    "command": "./Binaries/Linux/AAPG -port=${port} -SAP=${AUTH_PORT} -SQP=${QUERY_PORT} -servername=${SERVER_NAME}",
    "stopCode": 2,
    "pre": [
      {
        "if": "UPDATE_ON_BOOT",
        "type": "command",
        "commands": [
          "./steamcmd/steamcmd.sh +force_install_dir /pufferpanel +login anonymous +app_update ${SRCDS_APPID} +quit"
        ]
      }
    ],
    "stdin": {
      "type": "stdin"
    },
    "autostart": false,
    "autorecover": false,
    "autorestart": false
  },
  "environment": {
    "type": "docker",
    "image": "ghcr.io/ptero-eggs/steamcmd:debian",
    "portBindings": [
      "0.0.0.0:${port}:${port}/udp",
      "0.0.0.0:${QUERY_PORT}:${QUERY_PORT}/udp",
      "0.0.0.0:${AUTH_PORT}:${AUTH_PORT}/udp"
    ]
  },
  "supportedEnvironments": [
    {
      "type": "docker",
      "image": "ghcr.io/ptero-eggs/steamcmd:debian",
      "portBindings": [
        "0.0.0.0:${port}:${port}/udp",
        "0.0.0.0:${QUERY_PORT}:${QUERY_PORT}/udp",
        "0.0.0.0:${AUTH_PORT}:${AUTH_PORT}/udp"
      ]
    }
  ],
  "requirements": {
    "os": "linux",
    "arch": "amd64"
  }
}

{
  "type": "harshdoorstop",
  "display": "Operation Harsh Doorstop (Docker)",
  "data": {
    "MAX_PLAYERS": {
      "type": "integer",
      "value": 32,
      "display": "Max Players",
      "desc": "Maximum number of players on the server",
      "required": true,
      "userEdit": true
    },
    "QUERY_PORT": {
      "type": "integer",
      "value": 27005,
      "display": "Query Port",
      "desc": "Steam query port",
      "required": true,
      "userEdit": false
    },
    "RCON_MAX_AUTH_ATTEMPTS": {
      "type": "integer",
      "value": 3,
      "display": "RCON Max Auth Attempts",
      "desc": "Failed RCON logins allowed per connection",
      "required": true,
      "userEdit": true
    },
    "RCON_MAX_CONNECTIONS": {
      "type": "integer",
      "value": 5,
      "display": "RCON Max Connections",
      "desc": "Number of concurrent RCON connections",
      "required": true,
      "userEdit": true
    },
    "RCON_PASSWORD": {
      "type": "string",
      "value": "",
      "display": "RCON Password",
      "desc": "Password used for RCON",
      "required": false,
      "userEdit": true
    },
    "RCON_PORT": {
      "type": "integer",
      "value": 7779,
      "display": "RCON Port",
      "desc": "Port used for RCON",
      "required": true,
      "userEdit": false
    },
    "SERVER_NAME": {
      "type": "string",
      "value": "Harsh Doorstop Dedicated Server",
      "display": "Server Name",
      "desc": "Name in the server browser",
      "required": true,
      "userEdit": true
    },
    "SRCDS_APPID": {
      "type": "string",
      "value": "950900",
      "display": "Steam App ID",
      "desc": "SteamCMD application id of the Operation Harsh Doorstop dedicated server",
      "required": true,
      "userEdit": false
    },
    "UPDATE_ON_BOOT": {
      "type": "boolean",
      "value": true,
      "display": "Update On Boot",
      "desc": "Run SteamCMD before every server start so the server is always up to date",
      "required": false,
      "userEdit": true
    },
    "port": {
      "type": "integer",
      "value": 7777,
      "display": "Game Port",
      "desc": "UDP port the game server binds to",
      "required": true,
      "userEdit": false
    }
  },
  "install": [
    {
      "type": "mkdir",
      "target": "steamcmd"
    },
    {
      "type": "mkdir",
      "target": "steamapps"
    },
    {
      "type": "download",
      "files": [
        "https://steamcdn-a.akamaihd.net/client/installer/steamcmd_linux.tar.gz"
      ]
    },
    {
      "type": "extract",
      "source": "steamcmd_linux.tar.gz",
      "destination": "steamcmd"
    },
    {
      "type": "command",
      "commands": [
        "./steamcmd/steamcmd.sh +force_install_dir /pufferpanel +login anonymous +app_update ${SRCDS_APPID} validate +quit"
      ]
    },
    {
      "type": "mkdir",
      "target": ".steam/sdk32"
    },
    {
      "type": "mkdir",
      "target": ".steam/sdk64"
    },
    {
      "type": "command",
      "commands": [
        "cp steamcmd/linux32/steamclient.so .steam/sdk32/steamclient.so",
        "cp steamcmd/linux64/steamclient.so .steam/sdk64/steamclient.so",
        "rm -f steamcmd_linux.tar.gz",
        "chmod +x ./HarshDoorstop/Binaries/Linux/HarshDoorstopServer-Linux-Shipping"
      ]
    },
    {
      "type": "mkdir",
      "target": "HarshDoorstop/Saved/Config/LinuxServer"
    },
    {
      "if": "!file_exists('HarshDoorstop/Saved/Config/LinuxServer/Game.ini')",
      "type": "writefile",
      "target": "HarshDoorstop/Saved/Config/LinuxServer/Game.ini",
      "text": "[/Script/RCON.RCONServerSystem]\nbEnabled=True\nListenPort=${RCON_PORT}\nPassword=\"${RCON_PASSWORD}\"\nMaxActiveConnections=${RCON_MAX_CONNECTIONS}\nMaxAuthAttempts=${RCON_MAX_AUTH_ATTEMPTS}\n\n[/Script/Engine.GameSession]\nMaxPlayers=${MAX_PLAYERS}\nServerName=\"${SERVER_NAME}\"\n"
    }
  ],
  "run": {
    "command": "./HarshDoorstop/Binaries/Linux/HarshDoorstopServer-Linux-Shipping HarshDoorstop AAS-TestMap?MaxPlayers=${MAX_PLAYERS} -SteamServerName=${SERVER_NAME} -Port=${port} -MULTIHOME=0.0.0.0 -QueryPort=${QUERY_PORT} -log",
    "stopCode": 2,
    "pre": [
      {
        "if": "UPDATE_ON_BOOT",
        "type": "command",
        "commands": [
          "./steamcmd/steamcmd.sh +force_install_dir /pufferpanel +login anonymous +app_update ${SRCDS_APPID} +quit"
        ]
      },
      {
        "if": "file_exists('HarshDoorstop/Saved/Config/LinuxServer/Game.ini')",
        "type": "alterfile",
        "file": "HarshDoorstop/Saved/Config/LinuxServer/Game.ini",
        "search": "^ListenPort=.*$",
        "replace": "ListenPort=${RCON_PORT}",
        "regex": true
      },
      {
        "if": "file_exists('HarshDoorstop/Saved/Config/LinuxServer/Game.ini')",
        "type": "alterfile",
        "file": "HarshDoorstop/Saved/Config/LinuxServer/Game.ini",
        "search": "^Password=.*$",
        "replace": "Password=\"${RCON_PASSWORD}\"",
        "regex": true
      },
      {
        "if": "file_exists('HarshDoorstop/Saved/Config/LinuxServer/Game.ini')",
        "type": "alterfile",
        "file": "HarshDoorstop/Saved/Config/LinuxServer/Game.ini",
        "search": "^MaxActiveConnections=.*$",
        "replace": "MaxActiveConnections=${RCON_MAX_CONNECTIONS}",
        "regex": true
      },
      {
        "if": "file_exists('HarshDoorstop/Saved/Config/LinuxServer/Game.ini')",
        "type": "alterfile",
        "file": "HarshDoorstop/Saved/Config/LinuxServer/Game.ini",
        "search": "^MaxAuthAttempts=.*$",
        "replace": "MaxAuthAttempts=${RCON_MAX_AUTH_ATTEMPTS}",
        "regex": true
      },
      {
        "if": "file_exists('HarshDoorstop/Saved/Config/LinuxServer/Game.ini')",
        "type": "alterfile",
        "file": "HarshDoorstop/Saved/Config/LinuxServer/Game.ini",
        "search": "^MaxPlayers=.*$",
        "replace": "MaxPlayers=${MAX_PLAYERS}",
        "regex": true
      },
      {
        "if": "file_exists('HarshDoorstop/Saved/Config/LinuxServer/Game.ini')",
        "type": "alterfile",
        "file": "HarshDoorstop/Saved/Config/LinuxServer/Game.ini",
        "search": "^ServerName=.*$",
        "replace": "ServerName=\"${SERVER_NAME}\"",
        "regex": true
      }
    ],
    "stdin": {
      "type": "stdin"
    },
    "autostart": false,
    "autorecover": false,
    "autorestart": false
  },
  "environment": {
    "type": "docker",
    "image": "ghcr.io/ptero-eggs/steamcmd:debian",
    "portBindings": [
      "0.0.0.0:${port}:${port}/udp",
      "0.0.0.0:${QUERY_PORT}:${QUERY_PORT}/udp",
      "0.0.0.0:${RCON_PORT}:${RCON_PORT}/tcp"
    ]
  },
  "supportedEnvironments": [
    {
      "type": "docker",
      "image": "ghcr.io/ptero-eggs/steamcmd:debian",
      "portBindings": [
        "0.0.0.0:${port}:${port}/udp",
        "0.0.0.0:${QUERY_PORT}:${QUERY_PORT}/udp",
        "0.0.0.0:${RCON_PORT}:${RCON_PORT}/tcp"
      ]
    }
  ],
  "requirements": {
    "os": "linux",
    "arch": "amd64"
  }
}

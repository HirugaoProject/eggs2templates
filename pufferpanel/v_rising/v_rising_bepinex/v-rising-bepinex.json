  },
  "install": [
    {
      "type": "mkdir",
      "target": "steamcmd"
    },
    {
      "type": "mkdir",
      "target": "steamapps"
    },
    {
      "type": "download",
      "files": [
        "https://steamcdn-a.akamaihd.net/client/installer/steamcmd_linux.tar.gz"
      ]
    },
    {
      "type": "extract",
      "source": "steamcmd_linux.tar.gz",
      "destination": "steamcmd"
    },
    {
      "type": "command",
      "commands": [
        "./steamcmd/steamcmd.sh +force_install_dir /pufferpanel +login anonymous +@sSteamCmdForcePlatformType windows +app_update ${SRCDS_APPID} validate +quit"
      ]
    },
    {
      "type": "mkdir",
      "target": ".steam/sdk32"
    },
    {
      "type": "mkdir",
      "target": ".steam/sdk64"
    },
    {
      "type": "mkdir",
      "target": "save-data/Settings"
    },
    {
      "type": "mkdir",
      "target": ".wine"
    },
    {
      "type": "command",
      "commands": [
        "cp steamcmd/linux32/steamclient.so .steam/sdk32/steamclient.so",
        "cp steamcmd/linux64/steamclient.so .steam/sdk64/steamclient.so",
        "rm -f steamcmd_linux.tar.gz",
        "wineboot --init",
        "curl -sSL -A Mozilla -o BepInEx.zip https://thunderstore.io/package/download/BepInEx/BepInExPack_V_Rising/${BEPINEX_VERSION}/"
      ]
    },
    {
      "type": "extract",
      "source": "BepInEx.zip",
      "destination": "bepinex-pack"
    },
    {
      "type": "command",
      "commands": [
        "bash -c 'cp -rf bepinex-pack/BepInExPack_V_Rising/* . 2>/dev/null || cp -rf bepinex-pack/* .'",
        "rm -rf bepinex-pack BepInEx.zip dotnet",
        "bash -c '[ -f doorstop_config.ini ] && sed -i \"s/^enabled=false/enabled=true/\" doorstop_config.ini; true'"
      ]
    },
    {
      "if": "!file_exists('save-data/Settings/ServerHostSettings.json')",
      "type": "writefile",
      "target": "save-data/Settings/ServerHostSettings.json",
      "text": "{\n  \"Name\": \"${SERVER_NAME}\",\n  \"Description\": \"${DESCRIPTION}\",\n  \"Port\": ${port},\n  \"QueryPort\": ${QUERY_PORT},\n  \"MaxConnectedUsers\": ${MAX_PLAYERS},\n  \"MaxConnectedAdmins\": ${MAX_ADMINS},\n  \"ServerFps\": ${FPS},\n  \"SaveName\": \"${SAVE_NAME}\",\n  \"Password\": \"${SERVER_PASSWORD}\",\n  \"Secure\": ${SERVER_SECURE},\n  \"ListOnSteam\": ${SERVER_LIST},\n  \"ListOnEOS\": ${SERVER_LIST},\n  \"AutoSaveCount\": ${SAVE_COUNT},\n  \"AutoSaveInterval\": ${SAVE_INTERVAL},\n  \"CompressSaveFiles\": true,\n  \"GameSettingsPreset\": \"${GAME_SETTINGS_PRESET}\",\n  \"GameDifficultyPreset\": \"${GAME_DIFFICULTY_PRESET}\",\n  \"AdminOnlyDebugEvents\": ${ADMIN_ONLY_DEBUG_EVENTS},\n  \"DisableDebugEvents\": ${DEBUG_EVENTS},\n  \"HideIpAddress\": ${HIDE_IP},\n  \"LowerFPSWhenEmpty\": ${LOWER_FPS_WHEN_EMPTY},\n  \"LowerFPSWhenEmptyValue\": ${LOWER_FPS_WHEN_EMPTY_VALUE},\n  \"API\": {\n    \"Enabled\": false\n  },\n  \"Rcon\": {\n    \"Enabled\": ${RCON},\n    \"Port\": ${RCON_PORT},\n    \"Password\": \"${RCON_PASS}\"\n  }\n}\n"
    }
  ],
  "run": {
    "command": "bash -c 'exec xvfb-run wine ./VRisingServer.exe -persistentDataPath save-data -address 0.0.0.0 -gamePort ${port}'",
    "stopCode": 2,
    "environmentVars": {
      "DISPLAY": ":0",
      "LOGNAME": "container",
      "USER": "container",
      "WINEDEBUG": "-all",
      "WINEDLLOVERRIDES": "winhttp=n,b",
      "WINEPREFIX": "/pufferpanel/.wine",
      "WINEARCH": "win64"
    },
    "pre": [
      {
        "if": "UPDATE_ON_BOOT",
        "type": "command",
        "commands": [
          "bash -c 'V=\"\"; [ -n \"${VALIDATE}\" ] && V=validate; exec ./steamcmd/steamcmd.sh +force_install_dir /pufferpanel +login anonymous +@sSteamCmdForcePlatformType windows +app_update ${SRCDS_APPID} $V +quit'"
        ]
      },
      {
        "if": "file_exists('save-data/Settings/ServerHostSettings.json')",
        "type": "alterfile",
        "file": "save-data/Settings/ServerHostSettings.json",
        "search": "^  \"Name\": \".*\"",
        "replace": "  \"Name\": \"${SERVER_NAME}\"",
        "regex": true
      },
      {
        "if": "file_exists('save-data/Settings/ServerHostSettings.json')",
        "type": "alterfile",
        "file": "save-data/Settings/ServerHostSettings.json",
        "search": "^  \"Description\": \".*\"",
        "replace": "  \"Description\": \"${DESCRIPTION}\"",
        "regex": true
      },
      {
        "if": "file_exists('save-data/Settings/ServerHostSettings.json')",
        "type": "alterfile",
        "file": "save-data/Settings/ServerHostSettings.json",
        "search": "^  \"QueryPort\": [^,]*",
        "replace": "  \"QueryPort\": ${QUERY_PORT}",
        "regex": true
      },
      {
        "if": "file_exists('save-data/Settings/ServerHostSettings.json')",
        "type": "alterfile",
        "file": "save-data/Settings/ServerHostSettings.json",
        "search": "^  \"MaxConnectedUsers\": [^,]*",
        "replace": "  \"MaxConnectedUsers\": ${MAX_PLAYERS}",
        "regex": true
      },
      {
        "if": "file_exists('save-data/Settings/ServerHostSettings.json')",
        "type": "alterfile",
        "file": "save-data/Settings/ServerHostSettings.json",
        "search": "^  \"MaxConnectedAdmins\": [^,]*",
        "replace": "  \"MaxConnectedAdmins\": ${MAX_ADMINS}",
        "regex": true
      },
      {
        "if": "file_exists('save-data/Settings/ServerHostSettings.json')",
        "type": "alterfile",
        "file": "save-data/Settings/ServerHostSettings.json",
        "search": "^  \"ServerFps\": [^,]*",
        "replace": "  \"ServerFps\": ${FPS}",
        "regex": true
      },
      {
        "if": "file_exists('save-data/Settings/ServerHostSettings.json')",
        "type": "alterfile",
        "file": "save-data/Settings/ServerHostSettings.json",
        "search": "^  \"SaveName\": \".*\"",
        "replace": "  \"SaveName\": \"${SAVE_NAME}\"",
        "regex": true
      },
      {
        "if": "file_exists('save-data/Settings/ServerHostSettings.json')",
        "type": "alterfile",
        "file": "save-data/Settings/ServerHostSettings.json",
        "search": "^  \"Password\": \".*\"",
        "replace": "  \"Password\": \"${SERVER_PASSWORD}\"",
        "regex": true
      },
      {
        "if": "file_exists('save-data/Settings/ServerHostSettings.json')",
        "type": "alterfile",
        "file": "save-data/Settings/ServerHostSettings.json",
        "search": "^  \"Secure\": [^,]*",
        "replace": "  \"Secure\": ${SERVER_SECURE}",
        "regex": true
      },
      {
        "if": "file_exists('save-data/Settings/ServerHostSettings.json')",
        "type": "alterfile",
        "file": "save-data/Settings/ServerHostSettings.json",
        "search": "^  \"ListOnSteam\": [^,]*",
        "replace": "  \"ListOnSteam\": ${SERVER_LIST}",
        "regex": true
      },
      {
        "if": "file_exists('save-data/Settings/ServerHostSettings.json')",
        "type": "alterfile",
        "file": "save-data/Settings/ServerHostSettings.json",
        "search": "^  \"ListOnEOS\": [^,]*",
        "replace": "  \"ListOnEOS\": ${SERVER_LIST}",
        "regex": true
      },
      {
        "if": "file_exists('save-data/Settings/ServerHostSettings.json')",
        "type": "alterfile",
        "file": "save-data/Settings/ServerHostSettings.json",
        "search": "^  \"AutoSaveCount\": [^,]*",
        "replace": "  \"AutoSaveCount\": ${SAVE_COUNT}",
        "regex": true
      },
      {
        "if": "file_exists('save-data/Settings/ServerHostSettings.json')",
        "type": "alterfile",
        "file": "save-data/Settings/ServerHostSettings.json",
        "search": "^  \"AutoSaveInterval\": [^,]*",
        "replace": "  \"AutoSaveInterval\": ${SAVE_INTERVAL}",
        "regex": true
      },
      {
        "if": "file_exists('save-data/Settings/ServerHostSettings.json')",
        "type": "alterfile",
        "file": "save-data/Settings/ServerHostSettings.json",
        "search": "^  \"GameSettingsPreset\": \".*\"",
        "replace": "  \"GameSettingsPreset\": \"${GAME_SETTINGS_PRESET}\"",
        "regex": true
      },
      {
        "if": "file_exists('save-data/Settings/ServerHostSettings.json')",
        "type": "alterfile",
        "file": "save-data/Settings/ServerHostSettings.json",
        "search": "^  \"GameDifficultyPreset\": \".*\"",
        "replace": "  \"GameDifficultyPreset\": \"${GAME_DIFFICULTY_PRESET}\"",
        "regex": true
      },
      {
        "if": "file_exists('save-data/Settings/ServerHostSettings.json')",
        "type": "alterfile",
        "file": "save-data/Settings/ServerHostSettings.json",
        "search": "^  \"HideIpAddress\": [^,]*",
        "replace": "  \"HideIpAddress\": ${HIDE_IP}",
        "regex": true
      },
      {
        "if": "file_exists('save-data/Settings/ServerHostSettings.json')",
        "type": "alterfile",
        "file": "save-data/Settings/ServerHostSettings.json",
        "search": "^  \"LowerFPSWhenEmpty\": [^,]*",
        "replace": "  \"LowerFPSWhenEmpty\": ${LOWER_FPS_WHEN_EMPTY}",
        "regex": true
      },
      {
        "if": "file_exists('save-data/Settings/ServerHostSettings.json')",
        "type": "alterfile",
        "file": "save-data/Settings/ServerHostSettings.json",
        "search": "^  \"LowerFPSWhenEmptyValue\": [^,]*",
        "replace": "  \"LowerFPSWhenEmptyValue\": ${LOWER_FPS_WHEN_EMPTY_VALUE}",
        "regex": true
      },
      {
        "if": "file_exists('save-data/Settings/ServerHostSettings.json')",
        "type": "alterfile",
        "file": "save-data/Settings/ServerHostSettings.json",
        "search": "^  \"Port\": [^,]*",
        "replace": "  \"Port\": ${port}",
        "regex": true
      },
      {
        "if": "file_exists('save-data/Settings/ServerHostSettings.json')",
        "type": "alterfile",
        "file": "save-data/Settings/ServerHostSettings.json",
        "search": "^    \"Enabled\": [^,]*",
        "replace": "    \"Enabled\": ${RCON}",
        "regex": true
      },
      {
        "if": "file_exists('save-data/Settings/ServerHostSettings.json')",
        "type": "alterfile",
        "file": "save-data/Settings/ServerHostSettings.json",
        "search": "^    \"Port\": [^,]*",
        "replace": "    \"Port\": ${RCON_PORT}",
        "regex": true
      },
      {
        "if": "file_exists('save-data/Settings/ServerHostSettings.json')",
        "type": "alterfile",
        "file": "save-data/Settings/ServerHostSettings.json",
        "search": "^    \"Password\": \".*\"",
        "replace": "    \"Password\": \"${RCON_PASS}\"",
        "regex": true
      },
      {
        "if": "file_exists('save-data/Settings/ServerHostSettings.json')",
        "type": "alterfile",
        "file": "save-data/Settings/ServerHostSettings.json",
        "search": "^  \"AdminOnlyDebugEvents\": [^,]*",
        "replace": "  \"AdminOnlyDebugEvents\": ${ADMIN_ONLY_DEBUG_EVENTS}",
        "regex": true
      },
      {
        "if": "file_exists('save-data/Settings/ServerHostSettings.json')",
        "type": "alterfile",
        "file": "save-data/Settings/ServerHostSettings.json",
        "search": "^  \"DisableDebugEvents\": [^,]*",
        "replace": "  \"DisableDebugEvents\": ${DEBUG_EVENTS}",
        "regex": true
      }
    ],
    "stdin": {
      "type": "stdin"
    },
    "autostart": false,
    "autorecover": false,
    "autorestart": false
  },
  "environment": {
    "type": "docker",
    "image": "ghcr.io/ptero-eggs/yolks:wine_latest",
    "portBindings": [
      "0.0.0.0:${port}:${port}/udp",
      "0.0.0.0:${QUERY_PORT}:${QUERY_PORT}/udp",
      "0.0.0.0:${RCON_PORT}:${RCON_PORT}/tcp"
    ]
  },
  "supportedEnvironments": [
    {
      "type": "docker",
      "image": "ghcr.io/ptero-eggs/yolks:wine_latest",
      "portBindings": [
        "0.0.0.0:${port}:${port}/udp",
        "0.0.0.0:${QUERY_PORT}:${QUERY_PORT}/udp",
        "0.0.0.0:${RCON_PORT}:${RCON_PORT}/tcp"
      ]
    }
  ],
  "requirements": {
    "os": "linux",
    "arch": "amd64"
  }
}

{
  "type": "vrising",
  "display": "V Rising (Docker)",
  "data": {
    "SRCDS_APPID": {
      "type": "string",
      "value": "1829350",
      "display": "Steam App ID",
      "desc": "SteamCMD application id of the V Rising Dedicated Server dedicated server",
      "required": true,
      "userEdit": false
    },
    "UPDATE_ON_BOOT": {
      "type": "boolean",
      "value": true,
      "display": "Update On Boot",
      "desc": "Run SteamCMD before every server start so the server is always up to date",
      "required": false,
      "userEdit": true
    },
    "VALIDATE": {
      "type": "string",
      "value": "",
      "display": "Validate Server Files",
      "desc": "Any value turns on SteamCMD file verification during the boot update. It lengthens startup noticeably, so only set it when files look damaged.",
      "required": false,
      "userEdit": true
    },
    "VR_DESCRIPTION": {
      "type": "string",
      "value": "Welcome to the server!",
      "display": "Description",
      "desc": "Description shown next to the server",
      "required": true,
      "userEdit": true
    },
    "VR_DIFFICULTY_PRESET": {
      "type": "option",
      "value": "Difficulty_Normal",
      "display": "Difficulty Preset",
      "desc": "Difficulty applied to a new world",
      "required": true,
      "userEdit": true,
      "options": [
        {
          "value": "Difficulty_Normal",
          "display": "Normal"
        },
        {
          "value": "Difficulty_Hard",
          "display": "Hard"
        },
        {
          "value": "Difficulty_Brutal",
          "display": "Brutal"
        }

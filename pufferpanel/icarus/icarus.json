{
  "type": "icarus",
  "display": "Icarus (Docker)",
  "data": {
    "QUERY_PORT": {
      "type": "integer",
      "value": 27015,
      "display": "Server Query Port",
      "desc": "UDP port used for the Steam server list",
      "required": true,
      "userEdit": false
    },
    "SERVER_NAME": {
      "type": "string",
      "value": "IcarusServer",
      "display": "Server Name",
      "desc": "Name of the server in the server browser",
      "required": true,
      "userEdit": true
    },
    "SRCDS_APPID": {
      "type": "string",
      "value": "2089300",
      "display": "Steam App ID",
      "desc": "SteamCMD application id of the Icarus dedicated server (Windows build, run through Wine)",
      "required": true,
      "userEdit": false
    },
    "UPDATE_ON_BOOT": {
      "type": "boolean",
      "value": true,
      "display": "Update On Boot",
      "desc": "Run SteamCMD before every server start so the server is always up to date",
      "required": false,
      "userEdit": true
    },
    "port": {
      "type": "integer",
      "value": 17777,
      "display": "Port",
      "desc": "UDP port the server binds to",
      "required": true,
      "userEdit": false
    }
  },
  "install": [
    {
      "type": "mkdir",
      "target": "steamcmd"
    },
    {
      "type": "mkdir",
      "target": "steamapps"
    },
    {
      "type": "download",
      "files": [
        "https://steamcdn-a.akamaihd.net/client/installer/steamcmd_linux.tar.gz"
      ]
    },
    {
      "type": "extract",
      "source": "steamcmd_linux.tar.gz",
      "destination": "steamcmd"
    },
    {
      "type": "command",
      "commands": [
        "./steamcmd/steamcmd.sh +force_install_dir /pufferpanel +login anonymous +@sSteamCmdForcePlatformType windows +app_update ${SRCDS_APPID} validate +quit"
      ]
    },
    {
      "type": "mkdir",
      "target": ".steam/sdk32"
    },
    {
      "type": "mkdir",
      "target": ".steam/sdk64"
    },
    {
      "type": "mkdir",
      "target": "Icarus/Saved/Config"
    },
    {
      "type": "mkdir",
      "target": ".wine"
    },
    {
      "type": "command",
      "commands": [
        "cp steamcmd/linux32/steamclient.so .steam/sdk32/steamclient.so",
        "cp steamcmd/linux64/steamclient.so .steam/sdk64/steamclient.so",
        "rm -f steamcmd_linux.tar.gz",
        "wineboot --init",
        "winetricks -q vcrun2022 corefonts"
      ]
    },
    {
      "if": "!file_exists('Icarus/Saved/Config/ServerSettings.ini')",
      "type": "download",
      "files": [
        "https://raw.githubusercontent.com/RocketWerkz/IcarusDedicatedServer/main/ServerSettings.ini"
      ]
    },
    {
      "if": "file_exists('ServerSettings.ini')",
      "type": "move",
      "source": "ServerSettings.ini",
      "target": "Icarus/Saved/Config/ServerSettings.ini"
    }
  ],
  "run": {
    "command": "wine ./Icarus/Binaries/Win64/IcarusServer-Win64-Shipping.exe -Log -SteamServerName=${SERVER_NAME} -PORT=${port} -QueryPort=${QUERY_PORT}",
    "stopCode": 2,
    "environmentVars": {
      "DISPLAY": ":0",
      "LOGNAME": "container",
      "USER": "container",
      "WINEARCH": "win64",
      "WINEDEBUG": "-all",
      "WINEDLLOVERRIDES": "mscoree,mshtml=",
      "WINEPREFIX": "/pufferpanel/.wine"
    },
    "pre": [
      {
        "if": "UPDATE_ON_BOOT",
        "type": "command",
        "commands": [
          "./steamcmd/steamcmd.sh +force_install_dir /pufferpanel +login anonymous +@sSteamCmdForcePlatformType windows +app_update ${SRCDS_APPID} +quit"
        ]
      }
    ],
    "stdin": {
      "type": "stdin"
    },
    "autostart": false,
    "autorecover": false,
    "autorestart": false
  },
  "environment": {
    "type": "docker",
    "image": "ghcr.io/ptero-eggs/yolks:wine_latest",
    "portBindings": [
      "0.0.0.0:${port}:${port}/udp",
      "0.0.0.0:${QUERY_PORT}:${QUERY_PORT}/udp"
    ]
  },
  "supportedEnvironments": [
    {
      "type": "docker",
      "image": "ghcr.io/ptero-eggs/yolks:wine_latest",
      "portBindings": [
        "0.0.0.0:${port}:${port}/udp",
        "0.0.0.0:${QUERY_PORT}:${QUERY_PORT}/udp"
      ]
    }
  ],
  "requirements": {
    "os": "linux",
    "arch": "amd64"
  }
}

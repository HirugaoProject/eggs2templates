{
  "type": "hlds",
  "display": "Counter-Strike 1.6 - Vanilla (Docker)",
  "data": {
    "HOSTNAME": {
      "type": "string",
      "value": "Counter-Strike 1.6 Server",
      "display": "Server Hostname",
      "desc": "Hostname shown in the server browser",
      "required": true,
      "userEdit": true
    },
    "SRCDS_APPID": {
      "type": "string",
      "value": "90",
      "display": "Steam App ID",
      "desc": "SteamCMD application id of the Half-Life dedicated server. 90 is the HLDS server.",
      "required": true,
      "userEdit": false
    },
    "SRCDS_BETAID": {
      "type": "string",
      "value": "",
      "display": "Beta Branch",
      "desc": "Leave empty for the public branch, or use steam_legacy for the legacy version",
      "required": false,
      "userEdit": true
    },
    "SRV_PINGBOOST": {
      "type": "option",
      "value": "2",
      "display": "Pingboost",
      "desc": "Pingboost mode used by HLDS",
      "required": true,
      "userEdit": true,
      "options": [
        {
          "value": "0",
          "display": "0 - off"
        },
        {
          "value": "1",
          "display": "1"
        },
        {
          "value": "2",
          "display": "2"
        },
        {
          "value": "3",
          "display": "3"
        }
      ]
    },
    "SRV_SECURE": {
      "type": "option",
      "value": "secure",
      "display": "VAC",
      "desc": "Run the server secure (VAC enabled) or insecure",
      "required": true,
      "userEdit": true,
      "options": [
        {
          "value": "secure",
          "display": "Secure"
        },
        {
          "value": "insecure",
          "display": "Insecure"
        }
      ]
    },
    "SRV_SLOTS": {
      "type": "integer",
      "value": 32,
      "display": "Max Players",
      "desc": "Number of player slots",
      "required": true,
      "userEdit": true
    },
    "SRV_STARTMAP": {
      "type": "string",
      "value": "de_dust2",
      "display": "Start Map",
      "desc": "Map the server loads on boot",
      "required": true,
      "userEdit": true
    },
    "UPDATE_ON_BOOT": {
      "type": "boolean",
      "value": true,
      "display": "Update On Boot",
      "desc": "Run SteamCMD before every server start so the server is always up to date",
      "required": false,
      "userEdit": true
    },
    "port": {
      "type": "integer",
      "value": 27015,
      "display": "Port",
      "desc": "Port the server binds to",
      "required": true,
      "userEdit": false
    }
  },
  "install": [
    {
      "type": "mkdir",
      "target": "steamcmd"
    },
    {
      "type": "mkdir",
      "target": "steamapps"
    },
    {
      "type": "download",
      "files": [
        "https://steamcdn-a.akamaihd.net/client/installer/steamcmd_linux.tar.gz"
      ]
    },
    {
      "type": "extract",
      "source": "steamcmd_linux.tar.gz",
      "destination": "steamcmd"
    },
    {
      "if": "SRCDS_BETAID == ''",
      "type": "command",
      "commands": [
        "./steamcmd/steamcmd.sh +force_install_dir /pufferpanel +login anonymous +app_set_config 90 mod cstrike +app_update ${SRCDS_APPID} validate +quit"
      ]
    },
    {
      "if": "SRCDS_BETAID != ''",
      "type": "command",
      "commands": [
        "./steamcmd/steamcmd.sh +force_install_dir /pufferpanel +login anonymous +app_set_config 90 mod cstrike +app_update ${SRCDS_APPID} -beta ${SRCDS_BETAID} validate +quit"
      ]
    },
    {
      "type": "mkdir",
      "target": ".steam/sdk32"
    },
    {
      "type": "mkdir",
      "target": ".steam/sdk64"
    },
    {
      "type": "command",
      "commands": [
        "cp steamcmd/linux32/steamclient.so .steam/sdk32/steamclient.so",
        "cp steamcmd/linux64/steamclient.so .steam/sdk64/steamclient.so",
        "rm -f steamcmd_linux.tar.gz",
        "chmod +x ./hlds_run"
      ]
    }
  ],
  "run": {
    "command": "./hlds_run -console -game cstrike -${SRV_SECURE} +port ${port} +sv_lan 0 +maxplayers ${SRV_SLOTS} +map ${SRV_STARTMAP} +hostname \"${HOSTNAME}\" +sys_ticrate 1200 -pingboost ${SRV_PINGBOOST} -norestart",
    "stop": "quit",
    "pre": [
      {
        "if": "UPDATE_ON_BOOT && SRCDS_BETAID == ''",
        "type": "command",
        "commands": [
          "./steamcmd/steamcmd.sh +force_install_dir /pufferpanel +login anonymous +app_set_config 90 mod cstrike +app_update ${SRCDS_APPID} +quit"
        ]
      },
      {
        "if": "UPDATE_ON_BOOT && SRCDS_BETAID != ''",
        "type": "command",
        "commands": [
          "./steamcmd/steamcmd.sh +force_install_dir /pufferpanel +login anonymous +app_set_config 90 mod cstrike +app_update ${SRCDS_APPID} -beta ${SRCDS_BETAID} +quit"
        ]
      }
    ],
    "stdin": {
      "type": "stdin"
    },
    "autostart": false,
    "autorecover": false,
    "autorestart": false
  },
  "environment": {
    "type": "docker",
    "image": "ghcr.io/ptero-eggs/games:source",
    "portBindings": [
      "0.0.0.0:${port}:${port}/tcp",
      "0.0.0.0:${port}:${port}/udp"
    ]
  },
  "supportedEnvironments": [
    {
      "type": "docker",
      "image": "ghcr.io/ptero-eggs/games:source",
      "portBindings": [
        "0.0.0.0:${port}:${port}/tcp",
        "0.0.0.0:${port}:${port}/udp"
      ]
    }
  ],
  "requirements": {
    "os": "linux",
    "arch": "amd64"
  }
}

{
  "type": "mindustry",
  "display": "Mindustry (Docker)",
  "data": {
    "MAPNAME": {
      "type": "string",
      "value": "Tendrils",
      "display": "Map Name",
      "desc": "Map hosted on start. Built-in maps include Ancient Caldera, Fork, Fortress, Glacier, Islands, Labyrinth, Tendrils.",
      "required": true,
      "userEdit": true
    },
    "SERVER_MEMORY": {
      "type": "integer",
      "value": 1024,
      "display": "Memory (MB)",
      "desc": "Java heap size for the server",
      "required": true,
      "userEdit": true
    },
    "SERVER_NAME": {
      "type": "string",
      "value": "A PufferPanel Hosted Server",
      "display": "Server Name",
      "desc": "Name shown in the server list",
      "required": true,
      "userEdit": true
    },
    "VERSION": {
      "type": "string",
      "value": "latest",
      "display": "Version",
      "desc": "Release tag of Mindustry to install, for example v146, or latest for the newest release",
      "required": true,
      "userEdit": true
    },
    "port": {
      "type": "integer",
      "value": 6567,
      "display": "Port",
      "desc": "Port the server listens on for both TCP and UDP",
      "required": true,
      "userEdit": false
    }
  },
  "install": [
    {
      "if": "VERSION == 'latest'",
      "type": "download",
      "files": [
        "https://github.com/Anuken/Mindustry/releases/latest/download/server-release.jar"
      ]
    },
    {
      "if": "VERSION != 'latest'",
      "type": "download",
      "files": [
        "https://github.com/Anuken/Mindustry/releases/download/${VERSION}/server-release.jar"
      ]
    }
  ],
  "run": {
    "command": "java -Xms128M -Xmx${SERVER_MEMORY}M -jar server-release.jar config port ${port},config name ${SERVER_NAME},host ${MAPNAME}",
    "stop": "exit",
    "stdin": {
      "type": "stdin"
    },
    "autostart": false,
    "autorecover": false,
    "autorestart": false
  },
  "environment": {
    "type": "docker",
    "image": "ghcr.io/ptero-eggs/yolks:java_17",
    "portBindings": [
      "0.0.0.0:${port}:${port}/tcp",
      "0.0.0.0:${port}:${port}/udp"
    ]
  },
  "supportedEnvironments": [
    {
      "type": "docker",
      "image": "ghcr.io/ptero-eggs/yolks:java_17",
      "portBindings": [
        "0.0.0.0:${port}:${port}/tcp",
        "0.0.0.0:${port}:${port}/udp"
      ]
    }
  ],
  "requirements": {
    "os": "linux"
  }
}

{
  "type": "contagion",
  "display": "Contagion (Docker)",
  "data": {
    "SRCDS_APPID": {
      "type": "string",
      "value": "293030",
      "display": "Steam App ID",
      "desc": "SteamCMD application id of the Contagion dedicated server (Windows build, run through Wine)",
      "required": true,
      "userEdit": false
    },
    "SRV_CONFIG": {
      "type": "string",
      "value": "server.cfg",
      "display": "Server Config",
      "desc": "Name of the server configuration file inside the contagion/cfg directory",
      "required": true,
      "userEdit": true
    },
    "SRV_MAP": {
      "type": "string",
      "value": "ce_barlowe",
      "display": "Startup Map",
      "desc": "Map the server loads on boot",
      "required": true,
      "userEdit": true
    },
    "SRV_MAXPLAYERS": {
      "type": "integer",
      "value": 8,
      "display": "Max Players",
      "desc": "Maximum number of players allowed on the server",
      "required": true,
      "userEdit": true
    },
    "UPDATE_ON_BOOT": {
      "type": "boolean",
      "value": true,
      "display": "Update On Boot",
      "desc": "Run SteamCMD before every server start so the server is always up to date",
      "required": false,
      "userEdit": true
    },
    "port": {
      "type": "integer",
      "value": 27015,
      "display": "Port",
      "desc": "Port the server binds to",
      "required": true,
      "userEdit": false
    }
  },
  "install": [
    {
      "type": "mkdir",
      "target": "steamcmd"
    },
    {
      "type": "mkdir",
      "target": "steamapps"
    },
    {
      "type": "download",
      "files": [
        "https://steamcdn-a.akamaihd.net/client/installer/steamcmd_linux.tar.gz"
      ]
    },
    {
      "type": "extract",
      "source": "steamcmd_linux.tar.gz",
      "destination": "steamcmd"
    },
    {
      "type": "command",
      "commands": [
        "./steamcmd/steamcmd.sh +force_install_dir /pufferpanel +login anonymous +@sSteamCmdForcePlatformType windows +app_update ${SRCDS_APPID} validate +quit"
      ]
    },
    {
      "type": "mkdir",
      "target": ".steam/sdk32"
    },
    {
      "type": "mkdir",
      "target": ".steam/sdk64"
    },
    {
      "type": "mkdir",
      "target": ".wine"
    },
    {
      "type": "command",
      "commands": [
        "cp steamcmd/linux32/steamclient.so .steam/sdk32/steamclient.so",
        "cp steamcmd/linux64/steamclient.so .steam/sdk64/steamclient.so",
        "rm -f steamcmd_linux.tar.gz",
        "wineboot --init",
        "winetricks -q vcrun2013 vcrun2015 corefonts"
      ]
    }
  ],
  "run": {
    "command": "wine contagionds.exe -console -steam -log -condebug -conclearlog -dedicated -game \".\\contagion\" +sv_lan 0 -port ${port} +map ${SRV_MAP} +maxplayers ${SRV_MAXPLAYERS} +servercfgfile \"${SRV_CONFIG}\" -tickrate 128",
    "stopCode": 2,
    "environmentVars": {
      "DISPLAY": ":0",
      "LOGNAME": "container",
      "USER": "container",
      "WINEARCH": "win32",
      "WINEDEBUG": "-all",
      "WINEDLLOVERRIDES": "mscoree,mshtml=",
      "WINEPREFIX": "/pufferpanel/.wine"
    },
    "pre": [
      {
        "if": "UPDATE_ON_BOOT",
        "type": "command",
        "commands": [
          "./steamcmd/steamcmd.sh +force_install_dir /pufferpanel +login anonymous +@sSteamCmdForcePlatformType windows +app_update ${SRCDS_APPID} +quit"
        ]
      }
    ],
    "stdin": {
      "type": "stdin"
    },
    "autostart": false,
    "autorecover": false,
    "autorestart": false
  },
  "environment": {
    "type": "docker",
    "image": "ghcr.io/ptero-eggs/yolks:wine_latest",
    "portBindings": [
      "0.0.0.0:${port}:${port}/tcp",
      "0.0.0.0:${port}:${port}/udp"
    ]
  },
  "supportedEnvironments": [
    {
      "type": "docker",
      "image": "ghcr.io/ptero-eggs/yolks:wine_latest",
      "portBindings": [
        "0.0.0.0:${port}:${port}/tcp",
        "0.0.0.0:${port}:${port}/udp"
      ]
    }
  ],
  "requirements": {
    "os": "linux",
    "arch": "amd64"
  }
}

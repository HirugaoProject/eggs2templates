{
  "type": "srcds",
  "display": "Black Mesa (Docker)",
  "data": {
    "MAX_PLAYERS": {
      "type": "integer",
      "value": 32,
      "display": "Max Players",
      "desc": "Maximum number of players allowed on the server",
      "required": true,
      "userEdit": true
    },
    "SRCDS_APPID": {
      "type": "string",
      "value": "346680",
      "display": "Steam App ID",
      "desc": "SteamCMD application id of the Black Mesa dedicated server",
      "required": true,
      "userEdit": false
    },
    "SRCDS_CPORT": {
      "type": "integer",
      "value": 27005,
      "display": "Client Port",
      "desc": "Source engine client port",
      "required": true,
      "userEdit": false
    },
    "SRCDS_GAME": {
      "type": "string",
      "value": "bms",
      "display": "Game Name",
      "desc": "Source engine game directory to load",
      "required": true,
      "userEdit": false
    },
    "SRCDS_MAP": {
      "type": "string",
      "value": "dm_crossfire",
      "display": "Default Map",
      "desc": "Map loaded when the server starts",
      "required": true,
      "userEdit": true
    },
    "SRCDS_STV": {
      "type": "integer",
      "value": 27020,
      "display": "SourceTV Port",
      "desc": "Port used by SourceTV",
      "required": true,
      "userEdit": false
    },
    "UPDATE_ON_BOOT": {
      "type": "boolean",
      "value": true,
      "display": "Update On Boot",
      "desc": "Run SteamCMD before every server start so the server is always up to date",
      "required": false,
      "userEdit": true
    },
    "port": {
      "type": "integer",
      "value": 27015,
      "display": "Port",
      "desc": "Port the server binds to",
      "required": true,
      "userEdit": false
    }
  },
  "install": [
    {
      "type": "mkdir",
      "target": "steamcmd"
    },
    {
      "type": "mkdir",
      "target": "steamapps"
    },
    {
      "type": "download",
      "files": [
        "https://steamcdn-a.akamaihd.net/client/installer/steamcmd_linux.tar.gz"
      ]
    },
    {
      "type": "extract",
      "source": "steamcmd_linux.tar.gz",
      "destination": "steamcmd"
    },
    {
      "type": "command",
      "commands": [
        "./steamcmd/steamcmd.sh +force_install_dir /pufferpanel +login anonymous +app_update ${SRCDS_APPID} validate +quit"
      ]
    },
    {
      "type": "mkdir",
      "target": ".steam/sdk32"
    },
    {
      "type": "mkdir",
      "target": ".steam/sdk64"
    },
    {
      "type": "command",
      "commands": [
        "cp steamcmd/linux32/steamclient.so .steam/sdk32/steamclient.so",
        "cp steamcmd/linux64/steamclient.so .steam/sdk64/steamclient.so",
        "rm -f steamcmd_linux.tar.gz",
        "chmod +x ./srcds_run"
      ]
    }
  ],
  "run": {
    "command": "./srcds_run -game ${SRCDS_GAME} -strictportbind -ip 0.0.0.0 -port ${port} +clientport ${SRCDS_CPORT} +tv_port ${SRCDS_STV} +map ${SRCDS_MAP} +servercfgfile server.cfg -maxplayers ${MAX_PLAYERS}",
    "stop": "quit",
    "pre": [
      {
        "if": "UPDATE_ON_BOOT",
        "type": "command",
        "commands": [
          "./steamcmd/steamcmd.sh +force_install_dir /pufferpanel +login anonymous +app_update ${SRCDS_APPID} +quit"
        ]
      }
    ],
    "stdin": {
      "type": "stdin"
    },
    "autostart": false,
    "autorecover": false,
    "autorestart": false
  },
  "environment": {
    "type": "docker",
    "image": "ghcr.io/ptero-eggs/games:source",
    "portBindings": [
      "0.0.0.0:${port}:${port}/tcp",
      "0.0.0.0:${port}:${port}/udp",
      "0.0.0.0:${SRCDS_CPORT}:${SRCDS_CPORT}/udp",
      "0.0.0.0:${SRCDS_STV}:${SRCDS_STV}/udp"
    ]
  },
  "supportedEnvironments": [
    {
      "type": "docker",
      "image": "ghcr.io/ptero-eggs/games:source",
      "portBindings": [
        "0.0.0.0:${port}:${port}/tcp",
        "0.0.0.0:${port}:${port}/udp",
        "0.0.0.0:${SRCDS_CPORT}:${SRCDS_CPORT}/udp",
        "0.0.0.0:${SRCDS_STV}:${SRCDS_STV}/udp"
      ]
    }
  ],
  "requirements": {
    "os": "linux",
    "arch": "amd64"
  }
}

{
  "type": "hlds",
  "display": "Custom HLDS Engine Game (Docker)",
  "data": {
    "HLDS_GAME": {
      "type": "string",
      "value": "cstrike",
      "display": "Game Name",
      "desc": "Mod directory HLDS loads, for example valve, cstrike, dod, tfc, dmc, gearbox, ricochet",
      "required": true,
      "userEdit": true
    },
    "SRCDS_APPID": {
      "type": "string",
      "value": "90",
      "display": "Steam App ID",
      "desc": "SteamCMD application id used with HLDS. 90 is the Half-Life dedicated server.",
      "required": true,
      "userEdit": false
    },
    "SRCDS_BETAID": {
      "type": "string",
      "value": "",
      "display": "Beta Branch",
      "desc": "Leave empty for the public branch, or use steam_legacy for the legacy version",
      "required": false,
      "userEdit": true
    },
    "SRCDS_MAP": {
      "type": "string",
      "value": "de_dust2",
      "display": "Map",
      "desc": "Map the server loads on boot",
      "required": true,
      "userEdit": true
    },
    "UPDATE_ON_BOOT": {
      "type": "boolean",
      "value": false,
      "display": "Update On Boot",
      "desc": "Run SteamCMD before every server start",
      "required": false,
      "userEdit": true
    },
    "VAC_PORT": {
      "type": "integer",
      "value": 26900,
      "display": "VAC Port",
      "desc": "Port used for VAC",
      "required": true,
      "userEdit": false
    },
    "port": {
      "type": "integer",
      "value": 27015,
      "display": "Port",
      "desc": "Port the server binds to",
      "required": true,
      "userEdit": false
    }
  },
  "install": [
    {
      "type": "mkdir",
      "target": "steamcmd"
    },
    {
      "type": "mkdir",
      "target": "steamapps"
    },
    {
      "type": "download",
      "files": [
        "https://steamcdn-a.akamaihd.net/client/installer/steamcmd_linux.tar.gz"
      ]
    },
    {
      "type": "extract",
      "source": "steamcmd_linux.tar.gz",
      "destination": "steamcmd"
    },
    {
      "if": "SRCDS_BETAID == ''",
      "type": "command",
      "commands": [
        "./steamcmd/steamcmd.sh +force_install_dir /pufferpanel +login anonymous +app_set_config 90 mod ${HLDS_GAME} +app_update ${SRCDS_APPID} validate +quit"
      ]
    },
    {
      "if": "SRCDS_BETAID != ''",
      "type": "command",
      "commands": [
        "./steamcmd/steamcmd.sh +force_install_dir /pufferpanel +login anonymous +app_set_config 90 mod ${HLDS_GAME} +app_update ${SRCDS_APPID} -beta ${SRCDS_BETAID} validate +quit"
      ]
    },
    {
      "type": "mkdir",
      "target": ".steam/sdk32"
    },
    {
      "type": "mkdir",
      "target": ".steam/sdk64"
    },
    {
      "type": "command",
      "commands": [
        "cp steamcmd/linux32/steamclient.so .steam/sdk32/steamclient.so",
        "cp steamcmd/linux64/steamclient.so .steam/sdk64/steamclient.so",
        "rm -f steamcmd_linux.tar.gz",
        "chmod +x ./hlds_run"
      ]
    }
  ],
  "run": {
    "command": "./hlds_run -console -game ${HLDS_GAME} -port ${port} -sport ${VAC_PORT} +map ${SRCDS_MAP} +ip 0.0.0.0 -strictportbind -norestart",
    "stop": "quit",
    "pre": [
      {
        "if": "UPDATE_ON_BOOT && SRCDS_BETAID == ''",
        "type": "command",
        "commands": [
          "./steamcmd/steamcmd.sh +force_install_dir /pufferpanel +login anonymous +app_set_config 90 mod ${HLDS_GAME} +app_update ${SRCDS_APPID} +quit"
        ]
      },
      {
        "if": "UPDATE_ON_BOOT && SRCDS_BETAID != ''",
        "type": "command",
        "commands": [
          "./steamcmd/steamcmd.sh +force_install_dir /pufferpanel +login anonymous +app_set_config 90 mod ${HLDS_GAME} +app_update ${SRCDS_APPID} -beta ${SRCDS_BETAID} +quit"
        ]
      }
    ],
    "stdin": {
      "type": "stdin"
    },
    "autostart": false,
    "autorecover": false,
    "autorestart": false
  },
  "environment": {
    "type": "docker",
    "image": "ghcr.io/ptero-eggs/games:source",
    "portBindings": [
      "0.0.0.0:${port}:${port}/tcp",
      "0.0.0.0:${port}:${port}/udp",
      "0.0.0.0:${VAC_PORT}:${VAC_PORT}/udp"
    ]
  },
  "supportedEnvironments": [
    {
      "type": "docker",
      "image": "ghcr.io/ptero-eggs/games:source",
      "portBindings": [
        "0.0.0.0:${port}:${port}/tcp",
        "0.0.0.0:${port}:${port}/udp",
        "0.0.0.0:${VAC_PORT}:${VAC_PORT}/udp"
      ]
    }
  ],
  "requirements": {
    "os": "linux",
    "arch": "amd64"
  }
}

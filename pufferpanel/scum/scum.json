{
  "type": "scum",
  "display": "SCUM (Docker)",
  "data": {
    "MAX_PLAYERS": {
      "type": "integer",
      "value": 64,
      "display": "Max Players",
      "desc": "Maximum number of players on the server",
      "required": true,
      "userEdit": true
    },
    "QUERY_PORT": {
      "type": "integer",
      "value": 27015,
      "display": "Query Port",
      "desc": "Steam query port",
      "required": true,
      "userEdit": false
    },
    "SERVER_DESCRIPTION": {
      "type": "string",
      "value": "A PufferPanel Hosted Server",
      "display": "Server Description",
      "desc": "Description shown next to the server",
      "required": false,
      "userEdit": true
    },
    "SERVER_NAME": {
      "type": "string",
      "value": "A PufferPanel Hosted Server",
      "display": "Server Name",
      "desc": "Name of the server, at most 50 characters",
      "required": true,
      "userEdit": true
    },
    "SERVER_PASSWORD": {
      "type": "string",
      "value": "",
      "display": "Server Password",
      "desc": "Join password. Leave empty for a public server.",
      "required": false,
      "userEdit": true
    },
    "SERVER_PLAYSTYLE": {
      "type": "option",
      "value": "PVP",
      "display": "Playstyle",
      "desc": "Playstyle enforced on the server",
      "required": true,
      "userEdit": true,
      "options": [
        {
          "value": "PVP",
          "display": "PvP"
        },
        {
          "value": "PVE",
          "display": "PvE"
        }
      ]
    },
    "SRCDS_APPID": {
      "type": "string",
      "value": "3792580",
      "display": "Steam App ID",
      "desc": "SteamCMD application id of the SCUM dedicated server",
      "required": true,
      "userEdit": false
    },
    "UPDATE_ON_BOOT": {
      "type": "boolean",
      "value": true,
      "display": "Update On Boot",
      "desc": "Run SteamCMD before every server start so the server is always up to date",
      "required": false,
      "userEdit": true
    },
    "port": {
      "type": "integer",
      "value": 7777,
      "display": "Port",
      "desc": "UDP port the game server binds to",
      "required": true,
      "userEdit": false
    }
  },
  "install": [
    {
      "type": "mkdir",
      "target": "steamcmd"
    },
    {
      "type": "mkdir",
      "target": "steamapps"
    },
    {
      "type": "download",
      "files": [
        "https://steamcdn-a.akamaihd.net/client/installer/steamcmd_linux.tar.gz"
      ]
    },
    {
      "type": "extract",
      "source": "steamcmd_linux.tar.gz",
      "destination": "steamcmd"
    },
    {
      "type": "command",
      "commands": [
        "./steamcmd/steamcmd.sh +force_install_dir /pufferpanel +login anonymous +@sSteamCmdForcePlatformType windows +app_update ${SRCDS_APPID} validate +quit"
      ]
    },
    {
      "type": "mkdir",
      "target": ".steam/sdk32"
    },
    {
      "type": "mkdir",
      "target": ".steam/sdk64"
    },
    {
      "type": "command",
      "commands": [
        "cp steamcmd/linux32/steamclient.so .steam/sdk32/steamclient.so",
        "cp steamcmd/linux64/steamclient.so .steam/sdk64/steamclient.so",
        "rm -f steamcmd_linux.tar.gz"
      ]
    },
    {
      "type": "mkdir",
      "target": "SCUM/Saved/Config/WindowsServer"
    },
    {
      "type": "mkdir",
      "target": "SCUM/Saved/Logs"
    },
    {
      "type": "mkdir",
      "target": ".wine"
    },
    {
      "type": "command",
      "commands": [
        "wineboot --init"
      ]
    },
    {
      "if": "!file_exists('SCUM/Saved/Config/WindowsServer/ServerSettings.ini')",
      "type": "writefile",
      "target": "SCUM/Saved/Config/WindowsServer/ServerSettings.ini",
      "text": "[General]\nscum.ServerName=${SERVER_NAME}\nscum.ServerDescription=${SERVER_DESCRIPTION}\nscum.ServerPassword=${SERVER_PASSWORD}\nscum.ServerPlaystyle=${SERVER_PLAYSTYLE}\n"
    }
  ],
  "run": {
    "command": "wine ./SCUM/Binaries/Win64/SCUMServer.exe -Port=${port} -QueryPort=${QUERY_PORT} -MaxPlayers=${MAX_PLAYERS} -log",
    "stopCode": 2,
    "environmentVars": {
      "DISPLAY": ":0",
      "LOGNAME": "container",
      "USER": "container",
      "WINEDEBUG": "-all",
      "WINEDLLOVERRIDES": "mscoree,mshtml=",
      "WINEPREFIX": "/pufferpanel/.wine",
      "WINEARCH": "win64"
    },
    "pre": [
      {
        "if": "UPDATE_ON_BOOT",
        "type": "command",
        "commands": [
          "./steamcmd/steamcmd.sh +force_install_dir /pufferpanel +login anonymous +@sSteamCmdForcePlatformType windows +app_update ${SRCDS_APPID} +quit"
        ]
      },
      {
        "if": "file_exists('SCUM/Saved/Config/WindowsServer/ServerSettings.ini')",
        "type": "alterfile",
        "file": "SCUM/Saved/Config/WindowsServer/ServerSettings.ini",
        "search": "^scum\\.ServerName=.*$",
        "replace": "scum.ServerName=${SERVER_NAME}",
        "regex": true
      },
      {
        "if": "file_exists('SCUM/Saved/Config/WindowsServer/ServerSettings.ini')",
        "type": "alterfile",
        "file": "SCUM/Saved/Config/WindowsServer/ServerSettings.ini",
        "search": "^scum\\.ServerDescription=.*$",
        "replace": "scum.ServerDescription=${SERVER_DESCRIPTION}",
        "regex": true
      },
      {
        "if": "file_exists('SCUM/Saved/Config/WindowsServer/ServerSettings.ini')",
        "type": "alterfile",
        "file": "SCUM/Saved/Config/WindowsServer/ServerSettings.ini",
        "search": "^scum\\.ServerPassword=.*$",
        "replace": "scum.ServerPassword=${SERVER_PASSWORD}",
        "regex": true
      },
      {
        "if": "file_exists('SCUM/Saved/Config/WindowsServer/ServerSettings.ini')",
        "type": "alterfile",
        "file": "SCUM/Saved/Config/WindowsServer/ServerSettings.ini",
        "search": "^scum\\.ServerPlaystyle=.*$",
        "replace": "scum.ServerPlaystyle=${SERVER_PLAYSTYLE}",
        "regex": true
      }
    ],
    "stdin": {
      "type": "stdin"
    },
    "autostart": false,
    "autorecover": false,
    "autorestart": false
  },
  "environment": {
    "type": "docker",
    "image": "ghcr.io/ptero-eggs/yolks:wine_staging",
    "portBindings": [
      "0.0.0.0:${port}:${port}/udp",
      "0.0.0.0:${QUERY_PORT}:${QUERY_PORT}/udp"
    ]
  },
  "supportedEnvironments": [
    {
      "type": "docker",
      "image": "ghcr.io/ptero-eggs/yolks:wine_staging",
      "portBindings": [
        "0.0.0.0:${port}:${port}/udp",
        "0.0.0.0:${QUERY_PORT}:${QUERY_PORT}/udp"
      ]
    }
  ],
  "requirements": {
    "os": "linux",
    "arch": "amd64"
  }
}
